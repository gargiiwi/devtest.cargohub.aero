/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1100px) {

    .program-grid {
        grid-template-columns: minmax(0, 1fr) 400px;
        gap: 28px;
    }

    .program .feature-grid {
        grid-template-columns: repeat(2, 1fr);
        row-gap: 20px;
    }

    .program .feature {
        border-right: 0;
    }

    .program .feature:nth-child(1),
    .program .feature:nth-child(2) {
        border-bottom: 1px solid var(--border);
        padding-bottom: 16px;
    }
}


@media (max-width: 980px) {

    .program-grid {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .program .calculator-card {
        max-width: 100%;
    }
}


@media (max-width: 640px) {

    .program .container {
        max-width: calc(100% - 28px);
    }

    .program-copy h2 {
        font-size: 30px;
    }

    .program-copy .lead {
        font-size: 13px;
    }

    .program .feature-grid {
        grid-template-columns: 1fr;
        row-gap: 0;
    }

    .program .feature {
        padding: 16px 0 !important;
        border-right: 0;
        border-bottom: 1px solid var(--border);
    }

    .program .feature:first-child {
        padding-top: 0 !important;
    }

    .program .feature:last-child {
        border-bottom: 0;
    }

    .program-copy > div:last-child {
        flex-direction: column;
        align-items: stretch;
    }

    .program-copy > div:last-child .btn {
        width: 100%;
    }

    .program .calculator-card {
        padding: 17px;
    }

    .program .calc-head h3 {
        font-size: 16px;
    }

    .program #calculator-plugin #waight_val {
        width: calc(100% - 78px) !important;
    }
}

/* =========================================================
   TRUST / ORGANISATIONS
   ========================================================= */

.trust {
    width: 100%;
    margin: 0;
    padding: 24px 0 28px;
    background: #fff;
    border-bottom: 1px solid var(--border);
}

.trust .container {
    width: 1180px;
    max-width: calc(100% - 50px);
    margin: 0 auto;
    padding: 0;
}

.trust-label {
    margin: 0 0 16px;
    color: #7682a3;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .20em;
    line-height: 1.4;
}

.trust .logo-row {
    display: grid;
    grid-template-columns: repeat(6, 1fr) auto;
    align-items: center;
    gap: 0;
    width: 100%;
    margin: 0;
    padding: 0;
}

.trust .logo-row > span {
    min-width: 0;
    padding: 0 18px;
    color: #17336f;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    white-space: nowrap;
    border-right: 1px solid var(--border);
}

.trust .logo-row > span:first-child {
    padding-left: 0;
}

.trust .logo-row > span:last-child {
    border-right: 0;
}


/* =========================================================
   IATA AWARD
   ========================================================= */

.trust .award {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding-left: 20px;
    color: #17336f;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    line-height: 1.35;
    text-align: left;
}

.trust .award i {
    flex: 0 0 auto;
    color: var(--blue);
    font-size: 18px;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1100px) {

    .trust .logo-row {
        grid-template-columns: repeat(3, 1fr);
        row-gap: 18px;
    }

    .trust .logo-row > span {
        border-right: 1px solid var(--border);
    }

    .trust .logo-row > span:nth-child(3),
    .trust .logo-row > span:last-child {
        border-right: 0;
    }

    .trust .award {
        justify-content: flex-start;
    }
}


@media (max-width: 640px) {

    .trust {
        padding: 22px 0;
    }

    .trust .container {
        max-width: calc(100% - 28px);
    }

    .trust-label {
        margin-bottom: 14px;
        font-size: 8px;
    }

    .trust .logo-row {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .trust .logo-row > span,
    .trust .logo-row > span:first-child {
        width: 100%;
        padding: 10px 0;
        border-right: 0;
        border-bottom: 1px solid var(--border);
        text-align: left;
    }

    .trust .logo-row > span:last-child {
        border-bottom: 0;
    }

    .trust .award {
        padding: 12px 0 0;
    }
}

/* =========================================================
   SITE FOOTER
   ========================================================= */

.site-footer {
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: #0b2a67;
    color: #fff;
}

.footer-photo {
    position: absolute;
    inset: 0;
    background:
        linear-gradient(
            90deg,
            rgba(7,35,75,.97) 0%,
            rgba(7,42,85,.94) 45%,
            rgba(11,42,103,.88) 100%
        ),
        url('/img/cargo-aircraft.png') center / cover no-repeat;
}

.footer-content {
    position: relative;
    z-index: 2;
    width: 1180px;
    max-width: calc(100% - 50px);
    margin: 0 auto;
    padding: 42px 0 18px;
}


/* =========================================================
   FOOTER LINKS AREA
   ========================================================= */

.footer-links {
    display: grid;
    grid-template-columns: 1.45fr 1fr 1fr .85fr .85fr;
    gap: 30px;
    margin: 0;
    padding: 24px 0 30px;
    border-top: 0;
    border-top: 1px solid rgba(255, 255, 255, .45);
    border-bottom: 1px solid rgba(255, 255, 255, .45);
}

.footer-links > div {
    min-width: 0;
}

.footer-links h4 {
    margin: 0 0 11px;
    padding: 0;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
}

.footer-links p {
    margin: 0 0 5px;
    padding: 0;
    color: #d5e2f2;
    font-size: 11px;
    line-height: 1.65;
}

.footer-links a {
    color: #d5e2f2;
    text-decoration: none;
    transition: color .18s ease;
}

.footer-links a:hover {
    color: #fff;
    text-decoration: none;
}


/* =========================================================
   FOOTER BRAND
   ========================================================= */

.footer-brand {
    padding-right: 20px;
}

.footer-brand .brand {
    display: inline-flex;
    align-items: center;
    margin: 0 0 12px;
    color: #fff;
    text-decoration: none;
}

.footer-brand .brand-name {
    color: #fff;
    font-size: 20px;
    font-weight: 800;
    line-height: 1;
}

.footer-brand .brand-sub {
    margin-top: 4px;
    color: #c9dcf4;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .30em;
    line-height: 1;
}

.footer-brand > p {
    max-width: 280px;
    margin: 0;
    color: #cdddf0;
    font-size: 11px;
    line-height: 1.65;
}


/* =========================================================
   FOOTER CONTACT ICONS
   ========================================================= */

.footer-links p i {
    display: inline-block;
    width: 17px;
    margin-right: 5px;
    color: #8fc5ff;
    font-size: 11px;
    text-align: center;
}

.footer-links p i.fa-map-marker {
    vertical-align: top;
    margin-top: 3px;
}


/* =========================================================
   SOCIAL ICONS
   ========================================================= */

.socials {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
}

.socials a {
    display: grid;
    place-items: center;
    width: 31px;
    height: 31px;
    margin: 0;
    padding: 0;
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 4px;
    background: rgba(255,255,255,.08);
    color: #fff;
    font-size: 13px;
    text-decoration: none;
    transition: background .18s ease, border-color .18s ease;
}

.socials a:hover {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
}


/* =========================================================
   FOOTER BOTTOM
   ========================================================= */

.footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin: 0;
    padding: 15px 0 0;
    color: #b9cce2;
    font-size: 10px;
    line-height: 1.5;
}

.footer-bottom span:last-child {
    text-align: right;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 980px) {

    .footer-content {
        max-width: calc(100% - 30px);
    }

    .footer-links {
        grid-template-columns: repeat(3, 1fr);
        gap: 28px 22px;
    }

    .footer-brand {
        grid-column: 1 / -1;
        padding-right: 0;
    }
}


@media (max-width: 640px) {

    .footer-content {
        max-width: calc(100% - 28px);
        padding: 32px 0 16px;
    }

    .footer-links {
        grid-template-columns: 1fr 1fr;
        gap: 24px 18px;
        padding-bottom: 24px;
    }

    .footer-brand {
        grid-column: 1 / -1;
    }

    .footer-links h4 {
        font-size: 11px;
    }

    .footer-links p {
        font-size: 11px;
    }

    .footer-bottom {
        align-items: flex-start;
        flex-direction: column;
        gap: 5px;
    }

    .footer-bottom span:last-child {
        text-align: left;
    }
}


@media (max-width: 420px) {

    .footer-links {
        grid-template-columns: 1fr;
    }

    .footer-brand {
        grid-column: auto;
    }
}
.btn-footer {
    border: 1px solid rgba(255, 255, 255, .75);
    color: #fff;
    min-height: 31px;
    gap: 10px;
}
.footer-links p, .footer-links a {
    color: #d8e5f1;
    font-size: 13px;
    line-height: 1.7;
}
.cc-logo {
    display: flex !important;
