goToMap("united arab emirates");if(this.isOnJapanCoordinates(i,s,t.width,t.height))return void this.goToMap("japan");this.mapImageDisplay=this.destinationMapData.find(r=>r.name==this.activeTabCode).imageUrl,this.onChangeLoc.emit(""),this.isMapSelected=!1;}else{if(this.isOnManilaCoordinates(i,s,t.width,t.height))return void this.goToMap("manila");if(this.isOnCagayanDeOroCoordinates(i,s,t.width,t.height))return void this.goToMap("cagayan");if(this.isOnIloiloCoordinates(i,s,t.width,t.height))return void this.goToMap("iloilo");if(this.isOnClarkCoordinates(i,s,t.width,t.height))return void this.goToMap("clark");if(this.isOnCebuCoordinates(i,s,t.width,t.height))return void this.goToMap("cebu");if(this.isOnDavaoCoordinates(i,s,t.width,t.height))return void this.goToMap("davao");if(this.isOnKaliboCoordinates(i,s,t.width,t.height))return void this.goToMap("caticlan");this.mapImageDisplay=this.destinationMapData.find(r=>r.name==this.activeTabCode).imageUrl,this.onChangeLoc.emit(""),this.isMapSelected=!1;}}isOnThailandCoordinates(e,t,i,s){return Math.sqrt((e-.191*i)**2+(t-.634*s)**2)<50;}isOnSingaporeCoordinates(e,t,i,s){return Math.sqrt((e-.3324*i)**2+(t-.8325*s)**4)<65;}isOnAustraliaCoordinates(e,t,i,s){return Math.sqrt((e-.7806*i)**2+(t-.7291*s)**2)<50;}isOnBruneiCoordinates(e,t,i,s){return Math.sqrt((e-.4386*i)**2+(t-.7949*s)**4)<50;}isOnMalaysiaCoordinates(e,t,i,s){return Math.sqrt((e-.2593*i)**2+(t-.7342*s)**4)<60;}isOnChinaCoordinates(e,t,i,s){return Math.sqrt((e-.348*i)**2+(t-.3667*s)**2)<40;}isOnSouthKoreaCoordinates(e,t,i,s){return Math.sqrt((e-.6969*i)**2+(t-.265*s)**2)<50;}isOnVietnamCoordinates(e,t,i,s){return Math.sqrt(2*(e-.3519*i)**2+(t-.5906*s)**4)<60;}isOnIndonesiaCoordinates(e,t,i,s){return Math.sqrt((e-.4853*i)**2+(t-.9094*s)**2)<60;}isOnDubaiCoordinates(e,t,i,s){return Math.sqrt((e-.1706*i)**2+(t-.3496*s)**2)<75;}isOnJapanCoordinates(e,t,i,s){return Math.sqrt((e-.8275*i)**2+(t-.2752*s)**2)<55;}isOnManilaCoordinates(e,t,i,s){return Math.sqrt((e-.31*i)**2+(t