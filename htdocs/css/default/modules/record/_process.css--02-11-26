/* The Transfer modal */
#modal_transfer .modal_content {
	position: relative;
}
	
	#modal_transfer .transfer-zone {
		position: absolute;
		left: 10px;
		top: 10px;
		width: 770px;
		height: 384px;
	}
	
	#modal_transfer #transfer-rightbar {
		float: right;
		width: 234px;
		margin: 10px 10px 20px 10px;
		box-sizing: content-box;
	}
	
		#modal_transfer #transfer-rightbar > div {
			padding: 10px;
			border: 1px solid lightgray;
			box-sizing: border-box;
		}
	
		#modal_transfer #transfer-rightbar button {
			margin-top: 10px;
			text-align: left;
			padding-left: 8px;
		}
		
			#modal_transfer #transfer-rightbar button:first-child {
				margin-top: 0;
			}
			
	#modal_transfer input.transfer-row-toggle {
		zoom: 1.5;
		transform: scale(1.5);
		-ms-transform: scale(1.5);
		-webkit-transform: scale(1.5);
		transform-origin: center center;
		-ms-transform-origin: center center;
		-webkit-transform-origin: center center;
	}
	
	#modal_transfer .info-bar {
		padding-top: 14px;
		width: 1014px;
		line-height: 20px;	
	}
	
	#modal_transfer_ok {
		font-weight: bold;
	}
        
        
        
        
        
