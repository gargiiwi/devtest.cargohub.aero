    function buildPreliminaryChart(apiData) {

        // local month order (NOT constant)
        var monthsOrder = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

        // remove empty months
        var filtered = apiData.filter(function (row) {
            return (parseInt(row.active, 10) > 0 || parseInt(row.closed, 10) > 0);
        });

        // sort by month order
        filtered.sort(function (a, b) {
            return monthsOrder.indexOf(a.month) - monthsOrder.indexOf(b.month);
        });

        // build chart arrays
        var labels = [];
        var activeData = [];
        var closedData = [];

        filtered.forEach(function (row) {
            labels.push(row.month);
            activeData.push(parseInt(row.active, 10));
            closedData.push(parseInt(row.closed, 10));
        });

        return {
            labels: labels,
            datasets: [
                {
                    label: 'Active',
                    data: activeData,
                    color: '#0B8457'
                },
                {
                    label: 'Closed',
                    data: closedData,
                    color: '#C14F4F'
                }
            ]
        };
    }
    function buildFormalChart(apiData) {

        var monthsOrder = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

        // sort months correctly
        apiData.sort(function (a, b) {
            return monthsOrder.indexOf(a.month) - monthsOrder.indexOf(b.month);
        });

        var labels = [];
        var activeData = [];
        var closedData = [];

        for (var i = 0; i < apiData.length; i++) {
            labels.push(apiData[i].month);
            activeData.push(parseInt(apiData[i].active, 10));
            closedData.push(parseInt(apiData[i].closed, 10));
        }

        return {
            labels: labels,
            datasets: [
                {
                    label: 'Active',
                    data: activeData,
                    color: '#2563EB'
                },
                {
                    label: 'Closed',
                    data: closedData,
                    color: '#DC2626'
                }
            ]
        };
    }

    function createChart(id, type, labels, dataSets, onComplete, plugins = []) {
        // dataSets: array of objects like { label: 'Damage', data: [...], color: '#1E3A8A' }

        const canvas = document.getElementById(id);
        if (!canvas)
            return null;

        const ctx = canvas.getContext('2d');

        if (chartInstances[id]) {
            chartInstances[id].destroy();
        }

        chartInstances[id] = new Chart(ctx, {
            type,
            data: {
                labels,
                datasets: dataSets.map(ds => ({
                        label: ds.label,
                        data: ds.data,
                        backgroundColor: type === 'line' ? 'transparent' : ds.color,
                        borderColor: ds.color,
                        borderRadius: type === 'bar' ? 8 : 0,
                        tension: type === 'line' ? 0.4 : 0,
                        fill: false
                    }))
            },
            options: {
                ...modernOptions,
                animation: {
                    onComplete: () => {
                        if (typeof onComplete === 'function')
                            onComplete();
                    }
                }
            },
            plugins: plugins
        });

        return chartInstances[id];
    }

