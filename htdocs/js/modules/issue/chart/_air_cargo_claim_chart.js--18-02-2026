// Global chart instance
let totalFormalAmountChartInstance = null;
let totalFormalAmountOriginalData = [];

function renderTotalFormalAmountDoughnut(data) {
    showCardLoader('totalFormalAmountChart');

    const monthOrder = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

    const months = [];
    const totals = [];
    const colorsUsed = [];
    let totalAmount = 0;

    const backgroundColors = [
        '#93C5FD', '#BFDBFE', '#A7F3D0', '#6EE7B7',
        '#FDE68A', '#FECACA', '#FBCFE8', '#FCD34D',
        '#C7D2FE', '#E0E7FF', '#D9F99D', '#FEF3C7'
    ];

    const monthColumnMap = {
        Jan: 0, Feb: 0, Mar: 0, 
        Apr: 1,May: 1, Jun: 1,
        Jul: 2, Aug: 2,Sep: 2, 
        Oct: 3, Nov: 3, Dec: 3
    };

    // Build data (skip zero values)
    for (let i = 0; i < monthOrder.length; i++) {
        const m = monthOrder[i];
        if (data[m] && parseFloat(data[m].amount || 0) > 0) {
            const amount = parseFloat(data[m].amount);
            months.push(m);
            totals.push(Number(amount.toFixed(2)));
            colorsUsed.push(backgroundColors[i]);
            totalAmount += amount;
        }
    }

    $('#kpiFormalAmount').html(
        '$'+totalAmount.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })
    );
    $('#tFACTotal').html(
        '$'+totalAmount.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })
    );


    const ctx = document.getElementById('totalFormalAmountChart').getContext('2d');

    if (totalFormalAmountChartInstance) {
        totalFormalAmountChartInstance.destroy();
    }

    totalFormalAmountChartInstance = new Chart(ctx, {
        type: 'line',
        data: {
            labels: months,
            datasets: [{
                label: '',
                data: totals,
                borderColor: '#3B82F6',
                backgroundColor: 'rgba(59,130,246,0.15)',
                fill: true,
                tension: 0.3,
                pointRadius: 6,
                pointBackgroundColor: colorsUsed
            }]
        },
        options: {
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                datalabels: { display: false }
            },
            scales: {
                x: { grid: { display: false } },
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: v => v.toLocaleString()
                    }
                }
            }
        },
        plugins: [ChartDataLabels]
    });

    /* -----------------------------
       VALUES GRID (Month on top, amount below)
       Jan–Apr | May–Aug | Sep–Dec
    ------------------------------ */

    const legendContainer = document.getElementById('totalFormalAmountChartLegend');
    legendContainer.innerHTML = '';
    legendContainer.style.display = 'grid';
    legendContainer.style.gridTemplateColumns = 'repeat(4, 1fr)';
    legendContainer.style.gap = '12px';
    legendContainer.style.marginTop = '15px';

    const columns = [0, 1, 2,3].map(() => {
        const col = document.createElement('div');
        col.style.display = 'flex';
        col.style.flexDirection = 'column';
        col.style.gap = '12px';
        legendContainer.appendChild(col);
        return col;
    });

    months.forEach((month, i) => {
        const colIndex = monthColumnMap[month];
        if (colIndex === undefined) return;

        const item = document.createElement('div');
        item.style.display = 'flex';
        item.style.alignItems = 'flex-start';
        item.style.gap = '8px';

        const colorBox = document.createElement('span');
        colorBox.style.width = '12px';
        colorBox.style.height = '12px';
        colorBox.style.backgroundColor = colorsUsed[i];
        colorBox.style.borderRadius = '3px';
        colorBox.style.marginTop = '4px';

        const textWrapper = document.createElement('div');

        const monthText = document.createElement('div');
        monthText.textContent = month;
        monthText.style.fontWeight = '600';
        monthText.style.fontSize = '0.875rem';
        monthText.style.color = '#374151';

        const valueText = document.createElement('div');
        valueText.textContent = totals[i].toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
        valueText.style.fontSize = '0.8rem';
        valueText.style.color = '#6B7280';

        textWrapper.appendChild(monthText);
        textWrapper.appendChild(valueText);

        item.appendChild(colorBox);
        item.appendChild(textWrapper);

        columns[colIndex].appendChild(item);
    });

    hideCardLoader('totalFormalAmountChart');
}



