function updateActiveFormalClaim() {

    const monthOrder = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
    const colors = [
        "rgba(54,162,235,1)",
        "rgba(255,99,132,1)",
        "rgba(75,192,192,1)",
        "rgba(153,102,255,1)",
        "rgba(255,159,64,1)"
    ];

    // Normalize API data:
    // - force year DESC
    // - always Jan–Dec
    // - fill missing months with 0
    function normalizeData(data) {
        if (!data) {
            return { years: [], months: monthOrder, result: {} };
        }

        const years = Object.keys(data)
            .map(y => Number(y))
            .sort((a, b) => b - a)   // DESC
            .map(String);

        const result = {};

        years.forEach(y => {
            result[y] = monthOrder.map(m => Number(data[y]?.[m] || 0));
        });

        return { years, months: monthOrder, result };
    }

    function buildCheckboxes(id, chart, datasets) {
        const box = document.getElementById(id);
        box.innerHTML = "";

        datasets.forEach((ds, i) => {
            const lbl = document.createElement("label");
            lbl.style.display = "flex";
            lbl.style.alignItems = "center";
            lbl.style.gap = "6px";

            lbl.innerHTML = `
                <span style="width:12px;height:12px;background:${ds.backgroundColor}"></span>
                <input type="checkbox" checked> ${ds.label}
            `;

            lbl.querySelector("input").onchange = e => {
                chart.data.datasets[i].hidden = !e.target.checked;
                chart.update();
            };

            box.appendChild(lbl);
        });
    }

    function renderChart(chart, canvasId, checkboxId, years, months, data) {
        const ctx = document.getElementById(canvasId).getContext("2d");

        const datasets = years.map((y, i) => ({
            label: y,
            data: data[y],
            backgroundColor: colors[i % colors.length]
        }));

        if (chart) {
            chart.data.labels = months;
            chart.data.datasets = datasets;
            chart.update();
            buildCheckboxes(checkboxId, chart, datasets);
            return chart;
        }

        chart = new Chart(ctx, {
            type: "bar",
            data: { labels: months, datasets },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: "index", intersect: false },
                scales: {
                    x: {
            offset: true   
        },
                    y: { beginAtZero: true }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: c => `$ ${c.parsed.y.toLocaleString()}`
                        }
                    }
                }
            }
        });

        buildCheckboxes(checkboxId, chart, datasets);
        return chart;
    }

    function renderTable(bodyId, headRow, footRow, years, months, data) {
        headRow.innerHTML =
            "<th>Month</th>" +
            years.map(y => `<th>${y}</th>`).join("");

        const body = document.getElementById(bodyId);
        body.innerHTML = "";

        const totals = {};
        years.forEach(y => totals[y] = 0);

        months.forEach((m, i) => {
            let row = `<tr><td>${m}</td>`;
            years.forEach(y => {
                const v = data[y][i];
                totals[y] += v;
                row += `<td>${v ? "$ " + v.toLocaleString() : "-"}</td>`;
            });
            row += "</tr>";
            body.innerHTML += row;
        });

        footRow.innerHTML =
            "<th>Total</th>" +
            years.map(y => `<th>$ ${totals[y].toLocaleString()}</th>`).join("");
    }

