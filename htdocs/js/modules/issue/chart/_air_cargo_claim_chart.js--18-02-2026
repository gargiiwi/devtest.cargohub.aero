                "settledAmountChart",
                "settledYearChecks",
                settled.years,
                settled.months,
                settled.result
            );

            renderTable(
                "settledTableBody",
                document.querySelector("#settledTableBody").closest("table").querySelector("thead tr"),
                document.querySelector("#settledTableBody").closest("table").querySelector("tfoot tr"),
                settled.years,
                settled.months,
                settled.result
            );
        }
    );
    
    
    
    
    
