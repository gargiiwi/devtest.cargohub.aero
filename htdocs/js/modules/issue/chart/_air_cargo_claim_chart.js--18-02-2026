                document.querySelector("#claimedTableBody").closest("table").querySelector("tfoot tr"),
                claimed.years,
                claimed.months,
                claimed.result
            );

            // ===== SUGGESTED =====
            const suggested = normalizeData(x.totalAmountFormalSuggested);

            suggestedChart = renderChart(
                suggestedChart,
                "suggestedAmountChart",
                "suggestedYearChecks",
                suggested.years,
                suggested.months,
                suggested.result
            );

            renderTable(
