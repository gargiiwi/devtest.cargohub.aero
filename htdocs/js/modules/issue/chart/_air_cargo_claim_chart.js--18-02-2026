            activeData.push(parseInt(row.active, 10));
            closedData.push(parseInt(row.closed, 10));
        });

        return {
            labels: labels,
            datasets: [
                {
                    label: 'Active',
                    data: activeData,
                    color: '#0B8457'
                },
                {
                    label: 'Closed',
                    data: closedData,
                    color: '#C14F4F'
                }
            ]
        };
