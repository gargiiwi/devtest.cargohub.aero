{@<style type="text/css">
div#file-submit-area input {
	width: 500px;
}
label.halfwidth {
	display: block;
	width: 250px;
	float: left;
}
</style>}

<div id='issue_submit' class='zone jqx-rc-all'><form action="?action=form" autocomplete="off" enctype="multipart/form-data" id="issue_form" name="issue_form" method="post">{#use:form:
{!Left column}
<div class='column2'>

<h4 style="background-image: url('/img/icons16/report.png'); background-repeat: no-repeat; background-position: 4px;">Purchase Order</h4>
<table style="margin-bottom: 8px;">
	<tr{#if:PDT.display.req: class='required'}>
		<th><label>Date:</label></th>
		<td>
			{#use:PDT:<div id='{id}' name='{name}' data-value='{#if:value:{value}~date("Y/m/d")~}' class='calendar left'></div>}
		</td>
	</tr>
	
	{#if:%CFG.issue_submit.groups:{#use:group:<tr{#if:display.req: class='required'}>
		<th><label>Department:</label></th>
		<td><div id='{id}_combo'></div><input type='hidden' id='{id}' name='{name}' value='{value}' /></td>
	</tr>}}
	
	{#use:vb_number:<tr{#if:display.req: class='required'}>
		<th><label for='{id}'>{display.label}:</label></th>
		<td><input type='text' id='{id}' name='{name}' value='{value}' class='whitebg jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
	</tr>}
	{#use:vender_code:<tr{#if:display.req: class='required'}>
		<th><label for='{id}'>{display.label}:</label></th>
		<td><input type='text' id='{id}' name='{name}' value='{value}' class='whitebg jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
	</tr>}
	{#use:dangerous_good:<tr{#if:display.req: class='required'}>
		<th><label>Dangerous Good:</label></th>
		<td>
			<label style='display: block; width: 120px; float: left; margin-top: -3px;'>
				<input name="{name}" value="{options.0.value}"{#if:options.0.active: checked="checked"} type="radio" onClick='$("#area-cargo-event").hide(); $(".hint-cargo").show();'> {options.0.display}
			</label>
			<label style='display: block; width: 120px; float: left; margin-top: -3px;'>
				<input name="{name}" value="{options.1.value}"{#if:options.1.active: checked="checked"} type="radio" onClick='$("#area-cargo-event").show(); $(".hint-cargo").hide();'> {options.1.display}
			</label>
		</td>
	</tr>}
	{#use:invoice_number:<tr{#if:display.req: class='required'}>
		<th><label for='{id}'>{display.label}:</label></th>
		<td><input type='text' id='{id}' name='{name}' value='{value}' class='whitebg jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
	</tr>}
	{#use:awb_number:<tr{#if:display.req: class='required'}>
		<th><label for='{id}'>{display.label}:</label></th>
		<td><input type='text' id='{id}' name='{name}' value='{value}' class='whitebg jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
	</tr>}
	{#use:transporter:<tr{#if:display.req: class='required'}>
		<th><label for='{id}'>{display.label}:</label></th>
		<td><input type='text' id='{id}' name='{name}' value='{value}' class='whitebg jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
	</tr>}
	
	
	{#use:freight_costs:<tr{#if:display.req: class='required'}>
		<th><label for='{id}'>{display.label}</label></th>
		<td><input type='text' id='{id}' name='{name}' value='{value}' class='left skipcheck jqx-input jqx-input-{%jqxtheme} only-numbers medium{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} style='height: auto;' />}
			{#use:freight_costs_curr:<select id='{id}' name='{name}' style='float: left; margin-left: 5px; width: 80px; font-family: monospace; height: 24px;' class='currency_select_secondary whitebg skipcheck jqx-input jqx-input-{%jqxtheme}'>
				<option value='' selected='selected' hidden='hidden'>Select:</option>
				{#repeat:options:<option value='{value}'{#if:active: selected='selected'}>{display}</option>
				}
			</select>}
		</td>
	</tr>


</table>








{#if:%attachments:<br /><h4>Attached pictures and documents:</h4>{!Fallback mode, showing files on IE8}
<div id='attachments' style="margin-bottom: 8px; display: none;">
{#repeat:%attachments:
	<div class='file-download'><a target='_blank' href='/files?action=download_attachment&amp;track={^track}&amp;ch={chash}'><img src='/img/mime/{type}.png' alt="{type}"> {name}</a>{#if:description: <span class='gray'>({description})</span>}<br />
	<span class="gray">Uploaded:</span> {mtime}~date("Y-M-d H:i:s")~ | <span class="gray">Size:</span> {size}~numberformat~ bytes
	<div class='clear'></div></div>
}
</div>}



<br /><h4 style="background-image: url('/img/icons16/upload.png'); background-repeat: no-repeat; background-position: 4px;">Upload pictures and documents</h4>
<div id="uploads-dropzone" class="dropzone">{!The fancy DropZone}</div>
<div id="uploads-helper" style="display: none;">
	Click anywhere on the white space in the box above this text<br />or drag & drop your files there to <b>upload more documents</b>
</div>

</div>
{!Right column}
<div class='column2'>

<h4 style="background-image: url('/img/icons16/user1.png'); background-repeat: no-repeat; background-position: 4px; margin-top: 0px;">Submitter contact information and details<img src="/img/icons16/question.png" alt="Info" class="info-tip" data-tooltip="The button beside the e-mail address allows for more information to be entered (company name, phone number, etc.)." style='float: right; margin-right: 4px;' /></h4>
<div style="margin: 12px 0;">Please complete your contact details, including your <b>e-mail, department, and function</b> by clicking on the button the right side of the &quot;Submitted by&quot; line.</div>
<div id="issue-contacts"></div>
{!<div style="margin-bottom: 20px; height: 27px; padding-top: 2px;">
	<input type="button" value="Add another contact..." data-action="add-contact" style="margin-left: 182px;" />
	<img src="/img/icons16/question.png" alt="Info" class="info-tip" data-tooltip="Use this button if you need to specify other e-mail addresses besides your own." style='margin-left: 6px;' />
</div>}

{#include::includes/submit_proceed_box.html}

{!End of right column}</div>
<div class='clear'></div>

}
</form></div>

