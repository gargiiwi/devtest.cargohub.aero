{@<style type="text/css">
/* Some styles specific to claims */
label.dualcolcbx {
	display: block;
	width: 250px;
	float: left;
}
</style>}

<div id='issue_submit' class='zone jqx-rc-all'><form action="?action=form" autocomplete="off" enctype="multipart/form-data" id="issue_form" name="issue_form" method="post">{#use:form:
{!Left column}
<div class='column2'>

<h4 style="background-image: url('/img/icons16/contact_email.png'); background-repeat: no-repeat; background-position: 4px;" class="info-tip" data-tooltip="The button beside the e-mail address is used to enter more information<br />(company name, phone number, postal address, etc.).">Enter your <b>e-mail address</b> and complete your contact details:</h4>
<div id="issue-contacts"></div>
<div style="margin-bottom: 20px; height: 27px; padding-top: 2px;">
	<input type="button" value="Add another contact..." data-action="add-contact" style="margin-left: 182px;" />
	<img src="/img/icons16/question.png" alt="Info" class="info-tip" data-tooltip="Use this button if you need to specify other e-mail addresses besides your own." style='margin-left: 6px;' />
</div>

<h4 style="background-image: url('/img/icons16/question2.png'); background-repeat: no-repeat; background-position: 4px;">What is this ticket about</h4>
<table>
	{#if:%CFG.issue_submit.groups:{#use:group:<tr{#if:display.req: class='required'}>
		<th><label>Category:</label></th>
		<td><div id='{id}_combo'></div><input type='hidden' id='{id}' name='{name}' value='{value}' /></td>
	</tr>}}
	{#use:title:<tr{#if:display.req: class='required'}>
		<th><label for='{id}'>{display.label}:</label></th>
		<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
	</tr>}
	{#use:customer:<tr{#if:display.req: class='required'}>
		<th><label for='{id}'>{display.label}:</label></th>
		<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
	</tr>}
	<tr><td colspan="2" class="gray center" style="font-size: 80%;">(if submitting this ticket in the name of a 3rd party)</td></tr>
</table>
{#use:descr:<div{#if:display.req: class='required'}>
	<h5 style="text-indent: 10px;">Problem/ Question/ Suggestion/ Idea</h5>
	<textarea id='{id}' name='{name}' class='whitebg jqx-input jqx-input-{%jqxtheme} {#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} style="resize: vertical; border-width: 1px; height: 256px; min-height: 64px; max-height: 640px; width: 542px; margin-bottom: 16px; overflow: auto;">{value}</textarea>
</div>}

<h4 onClick='$(".hideable").toggle();' style="cursor: pointer; background-image: url('/img/icons16/check_box.png'); background-repeat: no-repeat; background-position: 4px;">Detailed information <span style="font-weight: normal;">(for support department)</span> - <span class='green'>Click to show/hide</span></h4>

<table class="hideable" style="display: none;">
	{#use:browser:<tr{#if:display.req: class='required'}>
		<td><h3>Internet Browser(s) used:</h3>{#repeat:options:<label class='dualcolcbx'><input name='{name}' type='checkbox' value='1'{#if:active: checked='checked'}> {display}</label>}<div class="clear"></div><br /></td>
	</tr>}
	{#use:opsys:<tr{#if:display.req: class='required'}>
		<td><h3>Computer's Operating System(s):</h3>{#repeat:options:<label class='dualcolcbx'><input name='{name}' type='checkbox' value='1'{#if:active: checked='checked'}> {display}</label>}</td>
	</tr>}
</table>

<h4 class="hideable" style="display: none; background-image: url('/img/icons16/wrench.png'); background-repeat: no-repeat; background-position: 4px;">Extra information</h4>
<table class="hideable" style="display: none;">
	{#use:section:<tr{#if:display.req: class='required'}>
		<th><label>{display.label}:</label></th>
		<td><select id='{id}' name='{name}' class='jqx-input jqx-input-{%jqxtheme} long'>
			{#repeat:options:<option value='{value}'{#if:active: selected='selected'}>{display}</option>
			}</select></td>
	</tr>}	
	{#use:loc_det:<tr{#if:display.req: class='required'}>
		<th><label for='{id}'>{display.label}:</label></th>
		<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
	</tr>}
	{#use:repeat:<tr{#if:display.req: class='required'}>
		<th><label>{display.label}:</label></th>
		<td>{#repeat:options:<label style='display: block; width: 120px; float: left;'><input name='{^name}' type='radio' value='{value}'{#if:active: checked='checked'}> {display}</label>}</td>
	</tr>}
	{#use:reproduce:<tr{#if:display.req: class='required'}>
		<th><label>{display.label}:</label></th>
		<td><textarea rows="7" id='{id}' name='{name}' class='jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} style="resize: none;">{value}</textarea></td>
	</tr>}
<tr><td colspan="2"><hr /></td></tr>
	{#use:work:<tr{#if:display.req: class='required'}>
		<th><label>{display.label}</label></th>
		<td><select id='{id}' name='{name}' class='jqx-input jqx-input-{%jqxtheme} long'>
			{#repeat:options:<option value='{value}'{#if:active: selected='selected'}>{display}</option>
			}</select></td>
	</tr>}
	{#use:phone_supp:<tr{#if:display.req: class='required'}>
		<th><label>{display.label}</label></th>
		<td>{#repeat:options:<label style='display: block; width: 120px; float: left;'><input name='{^name}' type='radio' value='{value}'{#if:active: checked='checked'}> {display}</label>}</td>
	</tr>}
	{#use:phone_cback:<tr{#if:display.req: class='required'}>
		<th><label for='{id}'>{display.label}:</label></th>
		<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input jqx-input-{%jqxtheme} long{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
	</tr>}
</table>

</div>
{!Right column}
<div class='column2'>

<h4 style="background-image: url('/img/icons16/check_box_list.png'); background-repeat: no-repeat; background-position: 4px;">Self service quick checklist</h4>
<ul style="padding-left: 16px; margin-bottom: 40px;">
	<li>Recommended internet browsers for Cargohub software are: <span class='gray'>(links)</span>
	<ul>
		<li><a href="https://www.google.com/chrome/index.html" target="_blank">Google Chrome</a></li>
		<li><a href="https://www.mozilla.org/en-US/firefox/" target="_blank">Mozilla Firefox</a></li>
		<li><a href="https://www.opera.com/" target="_blank">Opera Browser</a></li>
		<li><a href="https://www.microsoft.com/en-us/windows/microsoft-edge" target="_blank">Microsoft Edge</a></li>
	</ul>
	<p>This software doesn't work on very old internet browsers like <i>Internet Explorer 8, 9</i>, or not updated, more than 5 years old iMac or MacBook with Safari.<br />
	Keep your computer software up to date for security and performance!</p></li>
	<li>Mobile browsers (Android Phone/Tablet, iPhone, iPad) might work, but they are not officially supported. If encountering problems, please switch to a PC/Laptop</li>
	<li>If you have ad-blockers, popup-blockers and internet &quot;protection&quot; software we recommend whitelisting this address, as they might interfere with normal operation<br />
	Corporate firewalls and other restrictions on your connection might also interfere with the software.</li>
	<li>JavaScript must be turned on and not blocked by any browser extension</li>
	<li>Check your computer to be malware free!</li>
</ul>

<h4 style="background-image: url('/img/icons16/images.png'); background-repeat: no-repeat; background-position: 4px;">Screenshots, documents, examples</h4>
<table>
	<tr><td>
		{#if:%attachments:<br /><h4>Attached pictures and documents:</h4>{!Fallback mode, showing files on IE8}
		<div id='attachments' style="margin-bottom: 8px; display: none;">
		{#repeat:%attachments:
			<div class='file-download'><a target='_blank' href='/files?action=download_attachment&amp;track={^track}&amp;ch={chash}'><img src='/img/mime/{type}.png' alt="{type}"> {name}</a>{#if:description: <span class='gray'>({description})</span>}<br />
			<span class="gray">Uploaded:</span> {mtime}~date("Y-M-d H:i:s")~ | <span class="gray">Size:</span> {size}~numberformat~ bytes
			<div class='clear'></div></div>
		}
		</div>}
		<div id="uploads-dropzone" class="dropzone">{!The fancy DropZone}</div>
		<div id="uploads-helper" style="display: none;">
			Click anywhere on the white space in the box above this text<br />or drag & drop your files there to <b>upload more documents</b>
		</div>
	</td></tr>
</table>

{#include::includes/submit_proceed_box.html}

{!End of right column}</div>
<div class='clear'></div>


<div class='column2'>
	<div class='required' style='text-align: center;'><span style='padding: 7px; border: 1px solid red; display: block;'><span class='req_bullet'>&nbsp;</span> (Fields with this background color are required)</span></div>	
</div>
<div class='column2'>
</div>
<div class='clear'></div>

}
</form></div>

