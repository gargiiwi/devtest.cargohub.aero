<div id='issue_submit' class='zone jqx-rc-all'><form action="?action=form" autocomplete="off" enctype="multipart/form-data" id="issue_form" name="issue_form" method="post">{#use:form:
{!Left column}
<div class='column2'>
<h4>Training Scheduler:</h4>
<table>
	{#if:%CFG.issue_submit.groups:{#use:group:<tr{#if:display.req: class='required'}>
		<th style="width:30%;"><label>Training type:</label></th>
		<td><div id='{id}_combo'></div><input type='hidden' id='{id}' name='{name}' value='{value}' /></td>
	</tr>}}
	{#use:training_ttl:<tr{#if:display.req: class='required'}>
		<th><label>{display.label}:</label></th>
		<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input whitebg jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
	</tr>}
	 {#use:place_train:<tr{#if:display.req: class='required'}>
		<th><label>{display.label}:</label></th>
		<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input whitebg jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
	</tr>}
     {#use:train_loc:<tr{#if:display.req: class='required'}>
	<th><label>{display.label}:</label></th>
	<td>{#repeat:options:<label style='display: block; width: 120px; float: left; margin-top: -3px;'><input name='{^name}' type='radio' value="{value}"{#if:active: checked='checked'}> {display}</label>}</td>
   </tr>}
  	  {#use:no_train:<tr{#if:display.req: class='required'}>
		<th><label>{display.label}:</label></th>
		<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input whitebg jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
	</tr>}
		{#use:date_train:<tr{#if:display.req: class='required'}>
		<th><label>{display.label}:</label></th>
		<td>
			 <div id='{id}' name='{name}' data-value='{#if:value:{value}~date("Y/m/d")~}' class='calendar left'> </div>
		</td>
	</tr>}
	
	 {#use:date_end:<tr{#if:display.req: class='required'}>
		<th><label>{display.label}:</label></th>
		<td>
			 <div id='{id}' name='{name}' data-value='{#if:value:{value}~date("Y/m/d")~}' class='calendar left'> </div>
		</td>
	</tr>}
	
	
 {#use:train_exp:<tr{#if:display.req: class='required'}>
		<th><label>{display.label}:</label></th>
		<td>
			 <div id='{id}' name='{name}' data-value='{#if:value:{value}~date("Y/m/d")~}' class='calendar left'></div>
		</td>
	</tr>}
    {#use:training_remarks:<tr{#if:display.req: class='required'}>
		<th><label>{display.label}:</label></th>
		 
			<td>
			  <textarea rows="6" id='{id}' name='{name}' class='jqx-input jqx-input-{%jqxtheme} {#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} style="resize: none; border-width: 1px; width: 400px; margin-bottom: 16px;" placeholder="(If possible, please keep this information short)">{value}</textarea>
			    
		</td>
	</tr>}
  
  
  
  
</table>
<br /><h4 style="background-image: url('/img/icons16/upload.png'); background-repeat: no-repeat; background-position: 4px;">Upload pictures and documents</h4>
<div id="uploads-dropzone" class="dropzone">{!The fancy DropZone}</div>
<div id="uploads-helper" style="display: none;">
	Click anywhere on the white space in the box above this text<br />or drag & drop your files there to <b>upload more documents</b>
</div>

</div>
{!Right column}
<div class='column2'>
 
<h4 style="background-image: url('/img/icons16/user1.png'); background-repeat: no-repeat; background-position: 4px; margin-top: 0px;">Submitter contact information and details<img src="/img/icons16/question.png" alt="Info" class="info-tip" data-tooltip="The button beside the e-mail address allows for more information to be entered (company name, phone number, etc.)." style='float: right; margin-right: 4px;' /></h4>
<div style="margin: 12px 0;">Please complete your contact details, including your <b>e-mail, department, and function</b> by clicking on the button the right side of the &quot;Submitted by&quot; line.</div>
<div id="issue-contacts"></div>
{!<div style="margin-bottom: 20px; height: 27px; padding-top: 2px;">
	<input type="button" value="Add another contact..." data-action="add-contact" style="margin-left: 182px;" />
	<img src="/img/icons16/question.png" alt="Info" class="info-tip" data-tooltip="Use this button if you need to specify other e-mail addresses besides your own." style='margin-left: 6px;' />
</div>}
  {#include::includes/submit_proceed_box.html}

{!End of right column}</div>
<div class='clear'></div>

 
<div class='column2'>
</div>
<div class='clear'></div>

}
</form></div>
