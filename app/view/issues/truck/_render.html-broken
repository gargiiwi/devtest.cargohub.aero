{!Template for rendering the Truck Order as a string (html). This kind of view doesn't use any javascript for displaying the information and could be used to save a HTML file or send as a message/email
  Contacts have a "mailto:" href in them; Attachments are sent as links back into the system; All other values are simply formatted text}
{!TODO: A way to reorder these components (user, system, includes, issue data)}
{!The system might add it's own piece of text in certain situations}
{#if:_contents_system:<div class="system_contents">{_contents_system}</div>}
{!Users are able to add their own text}
{#if:_contents_user:<div class="user_contents">{_contents_user}</div>}
{!User signature can be added after the issue data}
{#if:_user_signature:<br /><hr /><div class="user_signature">{_user_signature}</div><br /><br />}
{!Support including extra templates here, which use the same data as this main template}
{#if:_includes:{#repeat:_includes:
	<div class="included_contents">{#include:%:{$}}</div>}}
{#use:issue:

<h4>Processing overview:</h4>
<table>
	<tr><th>Tracking ID:</th><td><b>{track}</b></td></tr>
	<tr><th>Submitted on date:</th><td>{ctime}~date("Y-M-d (H:i)")~</td></tr>
	{#if:edtime:<tr><th>Updated on date:</th><td>{edtime}~date("Y-M-d (H:i)")~</td></tr>}
</table>

{#if:%parts.contacts|%override:<h4>Contact(s) information</h4>
<table>
	{#repeat:contact_links:
		<tr><th valign="top">{label}:</th><td class='contact-item' data-con_id='{contact.id}'><div>{contact.name} &lt;<a href="mailto:{contact.email}">{contact.email}</a>&gt;</div>
		{#if:contact.xdata.company_name:<div><span class="gray">Company name:</span> {contact.xdata.company_name}</div>}
		{#if:contact.xdata.phone:<div><span class="gray">Phone number:</span> {contact.xdata.phone}</div>}
		</td></tr>}
</table>
}

<h4>Truck Identification:</h4>
{#use:%ist.xfield_def:<table class="infotable">
	<tr><th>Airline:</th><td>{^group.name}</td></tr>
	<tr><th>{feeder.n}:</th><td>{^xfields.feeder.value}</td></tr>
	<tr><th>{truck_no.n}:</th><td>{^xfields.truck_no:<span class='gray'>(not specified)</span>}</td></tr>
	<tr><td colspan='2'><hr /></td></tr>
	<tr><th>{origin.n}:</th><td>{^xfields.origin.value.name} ({^xfields.origin.value.IATA})</td></tr>
	<tr><th>Origin Country:</th><td>{^xfields.origin.value.country}</td></tr>
	<tr><th>{destination.n}:</th><td>{^xfields.destination.value.name} ({^xfields.destination.value.IATA})</td></tr>
	<tr><th>Destination Country:</th><td>{^xfields.destination.value.country}</td></tr>
	<tr><th>{non_airp.n}:</th><td>{^xfields.non_airp:<span class="gray">(not specified)</span>}</td></tr>
</table>}

{#if:%parts.truck-schedule|%override:
<h4>Travel Schedule:</h4>
{#use:%ist.xfield_def:
	<h3 style="text-indent: 30px;">Cargo pickup:</h3>
	<table class="infotable">
		<tr><th>{pick_date.n}:</th><td>{#if:^xfields.pick_date:{^xfields.pick_date}~date("Y-m-d")~}{#ifnot:^xfields.pick_date:<span class='gray'>(not specified)</span>}</td></tr>
		<tr><th>{pick_time.n}:</th><td>{^xfields.pick_time:<span class="gray">(not specified)</span>}</td></tr>
		<tr><th>{pick_est_time.n}:</th><td>{^xfields.pick_est_time.value:<span class="gray">(not specified)</span>}</td></tr>
		<tr><th>{pick_addr.n}:</th><td><div style="border: 1px solid lightgray; padding: 4px;">{^xfields.pick_addr}~nl2br~</div></td></tr>
	</table>
	<hr /><h3 style="text-indent: 30px;">Cargo delivery:</h3>
	<table class="infotable">
		<tr><th>{deliv_date.n}:</th><td>{#if:^xfields.deliv_date:{^xfields.deliv_date}~date("Y-m-d")~}{#ifnot:^xfields.deliv_date:<span class='gray'>(not specified)</span>}</td></tr>
		<tr><th>{deliv_time.n}:</th><td>{^xfields.deliv_time:<span class="gray">(not specified)</span>}</td></tr>
		<tr><th>{deliv_est_time.n}:</th><td>{^xfields.deliv_est_time.value:<span class="gray">(not specified)</span>}</td></tr>
		<tr><th>{deliv_addr.n}:</th><td><div style="border: 1px solid lightgray; padding: 4px;">{^xfields.deliv_addr}~nl2br~</div></td></tr>
	</table>
	<h4>Handler operations:</h4>	
	<table class="infotable">
		<tr><th>{arrival.n}:</th><td>{^xfields.arrival}</td></tr>
		<tr><th>{arrival_date.n}:</th><td>{#if:^xfields.arrival_date:{^xfields.arrival_date}~date("Y-m-d")~}{#ifnot:^xfields.arrival_date:<span class='gray'>(not specified)</span>}</td></tr>
		<tr><th>{license.n}:</th><td>{^xfields.license:<span class='gray'>(not specified)</span>}</td></tr>
		<tr><th>{departure.n}:</th><td>{^xfields.departure}</td></tr>
		<tr><th>{mrn_no.n}:</th><td>{^xfields.mrn_no:<span class='gray'>(not specified)</span>}</td></tr>
	</table>
}}

{#if:%parts.truck-docs|%override:
<h4>Documentation:</h4>
{#use:%ist.xfield_def:<table class="infotable">
	<tr><th>{documents.n}:</th><td>{#repeat:^xfields.documents:<span class='iss_document' id='iss_doc_{key}'>{value}</span>}</td></tr>
	<tr><th>{coll_date.n}:</th><td>{#if:^xfields.coll_date:{^xfields.coll_date}~date("Y-m-d")~}{#ifnot:^xfields.coll_date:<span class='gray'>(not specified)</span>}</td></tr>
	<tr><th>{coll_amount.n}:</th><td>{^xfields.coll_amount:<span class='gray'>(not specified)</span>}</td></tr>
	<tr><th>{coll_risk.n}:</th><td>{^xfields.coll_risk:<span class='gray'>(not specified)</span>}</td></tr>
	<tr><td colspan='2'><hr /></td></tr>
	<tr><th>{awb1.n}:</th><td><span style="width: 120px; display: inline-block;">{^xfields.awb1:<span class='gray'>(missing)</span>}</span> Pieces: <span>{^xfields.awb2_p}</span></td></tr>
	{#if:^xfields.awb2:<tr><th>{awb2.n}:</th><td><span style="width: 120px; display: inline-block;">{^xfields.awb2}</span> Pieces: <span>{^xfields.awb2_p}</span></td></tr>}
	{#if:^xfields.awb3:<tr><th>{awb3.n}:</th><td><span style="width: 120px; display: inline-block;">{^xfields.awb3}</span> Pieces: <span>{^xfields.awb3_p}</span></td></tr>}
	{#if:^xfields.awb4:<tr><th>{awb4.n}:</th><td><span style="width: 120px; display: inline-block;">{^xfields.awb4}</span> Pieces: <span>{^xfields.awb4_p}</span></td></tr>}
	{#if:^xfields.awb5:<tr><th>{awb5.n}:</th><td><span style="width: 120px; display: inline-block;">{^xfields.awb5}</span> Pieces: <span>{^xfields.awb5_p}</span></td></tr>}
	{#if:^xfields.awb6:<tr><th>{awb6.n}:</th><td><span style="width: 120px; display: inline-block;">{^xfields.awb6}</span> Pieces: <span>{^xfields.awb6_p}</span></td></tr>}
	{#if:^xfields.awb7:<tr><th>{awb7.n}:</th><td><span style="width: 120px; display: inline-block;">{^xfields.awb7}</span> Pieces: <span>{^xfields.awb7_p}</span></td></tr>}
	{#if:^xfields.awb8:<tr><th>{awb8.n}:</th><td><span style="width: 120px; display: inline-block;">{^xfields.awb8}</span> Pieces: <span>{^xfields.awb8_p}</span></td></tr>}
	{#if:^xfields.awb9:<tr><th>{awb9.n}:</th><td><span style="width: 120px; display: inline-block;">{^xfields.awb9}</span> Pieces: <span>{^xfields.awb9_p}</span></td></tr>}
</table>
{#if:^xfields.cnotes:
<h4>{cnotes.n}:</h4><div style="border: 1px solid lightgray; padding: 4px;">{^xfields.cnotes}~nl2br~</div>}
}}

{#if:%parts.attachments|%override:{#if:files:<h4>Attached documents:</h4>
<div id='attachments' style="margin-bottom: 8px;">
{#repeat:files:
	<div class='file-download'><a target='_blank' href='http://{%html.domain}/files?action=download_attachment&amp;track={^track}&amp;ch={chash}'><img src='http://{%html.domain}/img/mime/{mimetype}.png' alt="{mimetype}"> {name}</a> ({size}~numberformat~ bytes)<br />
	<span>{description}</span><div class='clear'></div></div>}
</div>}
}

}