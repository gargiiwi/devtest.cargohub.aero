{#use:form:<form action="" autocomplete="off" enctype="application/x-www-form-urlencoded" class="issue_form" name="issue_form" method="post">
	<table>
		{#use:name:<tr>
			<th style="width:25%;"><label>{display.label}:{#if:display.req: <span>&nbsp;</span>}</label></th>
			<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
		</tr>}
		
		 {#use:audit_number:<tr>
			<th><label>{display.label}:{#if:display.req: <span>&nbsp;</span>}</label></th>
			<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
		</tr>}
		
		<tr>
			<th style="width:25%;"><label>Scheduled Date:</label></th>
			<td>
				{#use:scheduled_date:<div id='{id}' name='{name}' data-value='{#if:value:{value}~date("Y/m/d")~}' class='calendar left'></div>}

			</td>
		</tr>
		
		{#use:rec_Pos:<tr style="display:none">
			<th><label>{display.label}{#if:display.req: <span>&nbsp;</span>}</label></th>
			<td>{#repeat:options:<label class="boxblock"><input name='{^name}' type='radio' value='{value}'{#if:active: checked='checked'}> {display}</label>}</td>
		</tr>}		
		{#use:has_Child:<tr style="display:none">
			<th><label>{display.label}{#if:display.req: <span>&nbsp;</span>}</label></th>
			<td>{#repeat:options:<label class="boxblock"><input name='{^name}' type='radio' value='{value}'{#if:active: checked='checked'}> {display}</label>}</td>
		</tr>}	
		
		{#use:inex:<tr>
			<th><label>{display.label}{#if:display.req: <span>&nbsp;</span>}</label></th>
			<td>{#repeat:options:<label class="boxblock"><input name='{^name}' type='radio' value='{value}'{#if:active: checked='checked'}> {display}</label>}</td>
		</tr>}
		{#use:scope:<tr>
			<th><label>{display.label}{#if:display.req: <span>&nbsp;</span>}</label></th>
			<td>{#repeat:options:<label class="boxblock"><input name='{^name}' type='radio' value='{value}'{#if:active: checked='checked'}> {display}</label>}</td>
		</tr>}
		<tr>
			<th><label>{code_loc.display.label}:</label></th>
			<td>
				{#use:code_loc:<input type='text' id='{id}' name='{name}' value='{value}' class='left jqx-input jqx-input-{%jqxtheme} medium{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} />}
				{#use:code_iso2:
					<span class="left" style="height: 22px; line-height: 22px; margin: 2px 8px;">{display.label}:</span>
					<select id='{id}' name='{name}' class="left dropselect" data-name='{name}' data-width="100" data-dwidth="100" data-dheight="290" data-filterable="1">
						<option value=''><span>--</span></option>
						{#repeat:options:<option value='{value}'{#if:active: selected='selected'}>{display}</option>
					}</select>
				}
			</td>
		</tr>
		{#use:audit_com_name:<tr>
			<th><label>{display.label}:{#if:display.req: <span>&nbsp;</span>}</label></th>
			<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
		</tr>}
		{#use:dept:<tr>
			<th><label>{display.label}:{#if:display.req: <span>&nbsp;</span>}</label></th>
			<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
		</tr>}
		{#use:requested:<tr>
			<th><label>{display.label}:{#if:display.req: <span>&nbsp;</span>}</label></th>
			<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
		</tr>}
			{#use:auditer_name:<tr>
			<th><label>{display.label}:{#if:display.req: <span>&nbsp;</span>}</label></th>
			<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
		</tr>}
		 {#use:2nd_auditor:<tr>
			<th><label>{display.label}:{#if:display.req: <span>&nbsp;</span>}</label></th>
			<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
		</tr>}
	  {#use:3rd_auditor:<tr>
			<th><label>{display.label}:{#if:display.req: <span>&nbsp;</span>}</label></th>
			<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
		</tr>}
	  {#use:main_rep:<tr>
			<th><label>{display.label}:{#if:display.req: <span>&nbsp;</span>}</label></th>
			<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
		</tr>}
	   {#use:main_email:<tr>
			<th><label>{display.label}:{#if:display.req: <span>&nbsp;</span>}</label></th>
			<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
		</tr>}
		{#use:auditer_depart:<tr>
			<th><label>{display.label}:{#if:display.req: <span>&nbsp;</span>}</label></th>
			<td><input type='text' id='{id}' name='{name}' value='{value}' class='jqx-input jqx-input-{%jqxtheme} maxlen{#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} /></td>
		</tr>}
		</table>
		<h4 style="margin-top: 15px; background-image: url('/img/icons16/numbers123.png'); background-repeat: no-repeat; background-position: 4px;">Audit Scheduler</h4>
		<table>
		<tr>
			<th style="width:25%;"><label>Repetition</label></th>
			<td>
				{#use:sched_rep:
<!-- 				<span class="left" style="height: 22px; line-height: 22px; margin: 0 4px; display: inline-block; width: 80px;">Repetition: </span> -->
				<select class="left"  id='{id}' name='{name}' class='jqx-input jqx-input-{%jqxtheme}' style="height: 24px;">
					{#repeat:options:<option value='{value}' {#if:active: selected='selected'}>{display}</option>}
				</select>}
			</td>
			</tr>
			<tr>
			<th><label>Start Date:</label></th>
			<td>
				{#use:date_start:<div id='{id}' name='{name}' data-value='{#if:value:{value}~date("Y/m/d")~}' class='calendar'></div>}</td>
				<td>
				{#use:date_end:<span class="left" style="height: 22px; line-height: 22px; margin: 0 0px; display: inline-block; width: 64px;">End Date: </span>
					<div id='{id}' name='{name}' data-value='{#if:value:{value}~date("Y/m/d")~}' class='calendar left'>
					</div>
				}
			</td>
		</tr>
	</table>
	
	{#use:comments:
		<h5>{display.label}:</h5>
		<textarea rows="7" id='{id}' name='{name}' class='walloftext jqx-input jqx-input-{%jqxtheme} {#if:display.error: field_error}'{#if:display.error: data-tooltip='{display.error}'} style="resize: none; border-width: 1px; width: 99%; margin-bottom: 16px;" placeholder="">{value}</textarea>		
	}
</form>}