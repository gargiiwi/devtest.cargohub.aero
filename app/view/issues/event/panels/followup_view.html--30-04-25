	<!--<h4 style="margin-top: 15px; background-image: url('/img/icons16/check_box.png'); background-repeat: no-repeat; background-position: 4px;">Contributing factors</h4>-->
	<p style="margin-top: 15px; border-bottom: 2px solid #ccc; padding-bottom: 5px; display: inline-block; background-image: url('/img/icons16/check_box.png'); background-repeat: no-repeat; background-position: left center; padding-left: 24px;">Contributing factors</p>
    
	<table>
		<tr><th>{cf_behav.n}:</th><td>{#ifnot:^xfields.cf_behav:<span class='gray'>---</span>}{#repeat:^xfields.cf_behav:<span class="itembox">{value}</span>}
			{#if:^xfields.cf_behav_oth:<span class="itembox">{^xfields.cf_behav_oth}</span>}
		</td></tr>
		<tr><th>{cf_rules.n}:</th><td>{#ifnot:^xfields.cf_rules:<span class='gray'>---</span>}{#repeat:^xfields.cf_rules:<span class="itembox">{value}</span>}
			{#if:^xfields.cf_rules_oth:<span class="itembox">{^xfields.cf_rules_oth}</span>}
		</td></tr>
		<tr><th>{cf_eq.n}:</th><td>{#ifnot:^xfields.cf_eq:<span class='gray'>---</span>}{#repeat:^xfields.cf_eq:<span class="itembox">{value}</span>}
			{#if:^xfields.cf_eq_oth:<span class="itembox">{^xfields.cf_eq_oth}</span>}
		</td></tr>
		<tr><th>{cf_org.n}:</th><td>{#ifnot:^xfields.cf_org:<span class='gray'>---</span>}{#repeat:^xfields.cf_org:<span class="itembox">{value}</span>}
			{#if:^xfields.cf_org_oth:<span class="itembox">{^xfields.cf_org_oth}</span>}
		</td></tr>
	</table>
}