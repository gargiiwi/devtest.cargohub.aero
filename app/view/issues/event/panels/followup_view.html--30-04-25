	{#ifnot:^xfields.respo:<div class='gray center'>---</div>}
	{#repeat:^xfields.respo:<span class="itembox">{value}</span>}
	<div class="clear"></div> -->
	<!-- <h5>{involved.n}</h5>
	{#ifnot:^xfields.involved:<div class='gray center'>---</div>}
