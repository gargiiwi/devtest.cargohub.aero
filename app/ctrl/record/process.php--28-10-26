    /**
     * Copies an existing contact linked to the record to a position in the user's adress book (personal, department, organization)
     * Optionally, attaches it to a certain label
     * @param MVC_Request $rq
     */
    public function action_Copy_Con2Contacts(MVC_Request $rq) {
        $con = $this->con->read($rq->con_id);
        if (!$con)
            return header("HTTP/1.0 500 Error - Contact not found, possible database error");

        // Insert the new contact into the user's own contacts
        $user = MVC_Core::$ss->user;
        switch ($rq->level) {
            case 'personal':
                $this->con->create("personal", $user['org_id'], array(
                    'name' => $con['name'],
                    'email' => $con['email'],
                    'xdata' => $con['xdata'],
                    'label_id' => $rq->label_id ?: null
                        ), $user['id']);
                break;
            case 'department':
                $this->con->create("department", $user['org_id'], array(
                    'name' => $con['name'],
                    'email' => $con['email'],
                    'xdata' => $con['xdata'],
                    'label_id' => $rq->label_id ?: null
                        ), $user['id'], $user['cdep_id']);
                break;
            case 'organization':
                $this->con->create("organization", $user['org_id'], array(
                    'name' => $con['name'],
                    'email' => $con['email'],
                    'xdata' => $con['xdata'],
                    'label_id' => $rq->label_id ?: null
                ));
                break;
        }

        return $this->send_JSON(array('response' => "Contact has been copied to your address book"));
    }

    /**
     * Sets selected contact as submitter - Existing submitter becomes of type "custom"
     */
    public function action_Set_Submitter() {
        list($rq, $rec, $org_id) = $this->check_Operation('issue_edit_contacts', "You are not allowed to perform this operation", 'post', array());
        if (!$rq->id)
            return header("HTTP/1.0 400 Contact ID not present in the request");

        $contact = $this->con->con2iss_Read($rec['id'], $rq->id, $this->user->is_Unrestricted() ? null : $org_id);
        if (!$contact)
            return header("HTTP/1.0 403 You may not have the access rights to modify this contact's role");

        if ($contact['role'] == "submitter")
            return header("HTTP/1.0 409 This contact is already the submitter");

        // So far so good
        if (!empty($rec['submitter']['id'])) {
            if (!$this->user->is_Unrestricted() && !empty($rec['submitter']['org_id']) && $rec['submitter']['org_id'] != $org_id)
                return header("HTTP/1.0 403 The submitter contact belongs to another organization. Changing the submitter is not allowed");

            // Update submitter contact link, set role to "custom", label to "Original submitter"
            $this->con->con2iss_Update($rec['id'], $rec['submitter']['id'], array(
                'role' => "custom",
                'label' => "Original submitter",
                'visibility' => "shared"
            ));
        }
        // Update the selected contact, setting it as submitter
        $this->con->con2iss_Update($rec['id'], $contact['contact_id'], array(
            'role' => "submitter",
            'label' => "Submitted by",
            'visibility' => "public"
        ));
        // Update the record itself, changing "submit_id" (submit_ip is not affected)
        $this->record->update($rec['id'], array(
            'submit_id' => $contact['contact_id']
        ));

        $this->send_JSON(array('response' => "The contact has been set as submitter. Reload the record overview to see the change"));
    }

