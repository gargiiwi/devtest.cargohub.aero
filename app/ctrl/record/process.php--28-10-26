    /**
     * Call to mark record process for the organization
     * -- Only supports [ close, open, delete ], the rest are automatic
     * @param MVC_Request $rq
     */
    public function action_Mark_Process(MVC_Request $post) {
        switch ($post->command) {
            // Hide the record from the primary view in the grid (It can still be seen in Show ALL mode)
            case 'close':
                list($post, $rec, $org_id) = $this->check_Operation('issue_close', "You are not allowed to close record %s.", 'post');

                // Check if there are active tasks, if so, do not allow closing
                // -- the tasks themselves must be in a closed state (completed, failed, expired, closed) before the record can be closed
                $m_task = new App_Model_Task();
                $active_tasks = $m_task->get_List(array(), function ($q, $params) use ($org_id, $rec) {
                    $q->where('`link_type` = "record"')
                            ->where('`link_id` = ?', $rec['id'])
                            ->where('`status` IN(?)', array('new', 'assigned', 'inprogress', 'onhold'));

                    if (!$params[0])
                        $q->where('`org_id` = ?', $org_id);
                }, array($this->user->is_Unrestricted()));

                if ($active_tasks && count($active_tasks) > 0) {
                    $pending_task = new App_Model_Task();
                    $pending_task->check_Ovd_task($rec['id']);
                    $pending_task->update_Bulk(function (QueryFactory $q) use ($rec) {
                        $q->where("`link_type` = 'record'")
                                ->where("`status` != 'completed'")
                                ->where("`link_id` = ?", $rec['id']);
                        return true;
                    }, array(
                        'status' => "failed"
                    ));
                    if (!$pending_task) {
                        $count_active_tasks = count($active_tasks);
                        if ($count_active_tasks == 1) {
                            $txt1 = "is still one active TASK";
                            $txt2 = "it";
                        } else {
                            $txt1 = "are still {$count_active_tasks} active TASKS";
                            $txt2 = "them";
                        }
                        return header("HTTP/1.0 403 Cannot close the record as there {$txt1}. Please Complete/Fail or Delete {$txt2}");
                    }
                }
                
//                IWI If record close then all active capa should be close start
                
                $getActiveCapaDetails =  $this->record->getActiveCapaDetails($rec['id']);   
                $active_capa = $getActiveCapaDetails->num_rows;
                if($active_capa>0){
                    $this->record->setAllCapaClosedByRecord($rec['id']);
                }                                                                            
                
//                IWI If record close then all active capa should be close end
                
                

                $this->record->org_MarkProcess($rec['id'], 'closed', $org_id, false, $rec['linktime']);

                /* 				// Not ok anymore, as this ignores Actions
                  $m_task = new App_Model_Task();
                  $m_task-> update_Bulk(function(QueryFactory $q) use($rec) {
                  $q	-> where("`link_type` = 'record'")
                  -> where("`link_id` = ?", $rec['id']);
                  return true;
                  }, array(
                  'status'=> "closed"
                  ));
                 */
                $this->evan->add("The record {$post->track} has been closed. It can be reopened if necessary", "ok");
                $this->send_JSON(array('success' => true));
                break;
            // Set the record as visible in the main grid
            case 'open':
                list($post, $rec, $org_id) = $this->check_Operation('issue_close', "You are not allowed to (re)open record %s.", 'post');
                $process = empty($rec['shared_org_ids']) ? 'reactive' : 'shared';
                $this->record->org_MarkProcess($rec['id'], $process, $org_id, false, $rec['linktime']);

                $this->evan->add("The record {$post->track} has been re(opened).", "ok");
                $this->send_JSON(array('success' => true));
                break;
            // Apparent deletion (The record should not be visible by non-admin in any situation)
            case 'delete':
                list($post, $rec, $org_id) = $this->check_Operation('issue_delete', "You are not allowed to DELETE record %s.", 'post');
                // TODO: this is actually identical to disable_Org
//                IWI delete all task when delete record start
                $del_rec_id=$rec['id'];
                $del_org_id=$org_id;
//                IWI delete all task when delete record end
                $r = $this->record->org_Disable($post->track, $org_id);
                if (!$r)
                    return header("HTTP/1.0 500 Error while attempting to disable organization's access.");
//                IWI delete all task when delete record start
                $this->record->setAllTaskClosedByRecord($del_rec_id,$del_org_id);
//                IWI delete all task when delete record end

                $this->evan->add("The record {$post->track} has been deleted. Emergency undelete still available for 7 days.", "ok");
                $this->send_JSON(array('success' => true));
                break;
            case 'count' :
                list($post, $rec, $org_id) = $this->check_Operation('issue_close', "You are not allowed to close record %s.", 'post');
                // Check if there are active tasks, if so, do not allow closing
                // -- the tasks themselves must be in a closed state (completed, failed, expired, closed) before the record can be closed
                $m_task = new App_Model_Task();
                $active_tasks = $m_task->get_List(array(), function ($q, $params) use ($org_id, $rec) {
                    $q->where('`link_type` = "record"')
                            ->where('`link_id` = ?', $rec['id'])
                            ->where('`status` IN(?)', array('new', 'assigned', 'inprogress', 'onhold'));

                    if (!$params[0])
                        $q->where('`org_id` = ?', $org_id);
                }, array($this->user->is_Unrestricted()));

                if (empty($active_tasks))
                    $active_tasks = 0;
                else
                    $active_tasks = count($active_tasks);

                $this->send_JSON(array('success' => true, 'count' => $active_tasks));
                break;
//                IWI If record close then all active capa should be close start
                 case 'active_capa_count' :
                list($post, $rec, $org_id) = $this->check_Operation('issue_close', "You are not allowed to close record %s.", 'post');
                $org_id = MVC_Core::$ss->user['org_id'];
                $link_id = (isset($post->link_id)? $post->link_id : '');
