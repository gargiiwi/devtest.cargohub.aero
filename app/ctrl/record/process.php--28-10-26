    /**
     * Tests if logged in user has access to the record specified by $rq-> track
     * If not, the user is redirected to the address specified in $this-> CFG['home']
     *
     * This method also verifies if the record itself exists
     *
     * @param MVC_Request $rq The request
     * @param array $user User base information [Record is tested against this user]
     * @param int $perspective When user is a superuser, this is the organization ID (When not specified, it will get a value from the record's current master_org_id)
     * @return array Record primary data (Metadata and Organization) - Everything else is accessed by the individual panels with their own read functions
     */
    private function check_Record(MVC_Request $rq, $user, &$perspective = null) {
        // Read record data and it's typedef
        $read_settings = array();

        $record_wtr = array('issue', 'quickindex', 'organization', 'assigned', 'group', 'contacts', 'access_users'); // Contacts are used by current version of Build E-mail. TODO: Rework it to read contactss only when needed
        if ($user['status'] == 'admin' || $user['status'] == 'supervisor') {
            // Do not place self in list of accessing users (stealth mode)
            $read_settings['no_access_update'] = true;
            // Allows reading a "deleted" (hidden) record (normal users are not being returned records with process = 'hidden', as if the record doesn't exist)
            $read_settings['access_hidden'] = true;
            // Admin needs the list of orgs sharing the record for the "Perspective" selector (just ID, Name)
            $record_wtr[] = 'shared_orgs';
            // Admin can access full record data (unfiltered, from any connected organization, unfiltered by department and user)
            $rec = $this->record->read($rq->track, $record_wtr, $perspective, null, null, $read_settings);
            if (empty($perspective) && !empty($rec['master_org_id']))
                $perspective = (int) $rec['master_org_id'];

            // Save the perspective in the session to be used by other functions requiring the session variable to exist
            // Was the perspective changed from what exists in the session ? (Or there was nothing in the session) - If yes, regenerate current record type ID which exists in the session.
            if (!MVC_Core::$ss->perspective || $perspective != MVC_Core::$ss->perspective) {
                MVC_Core::$ss->perspective = $perspective;
            }
        } else {
            // TODO: Check if all of this is actually needed, or only within certain tabs
            // Users with certain privileges can ignore certain limits/filters ( for example, a company manager might see all notes/tasks/files/conversations for his entire organization, or see issues from all departments )
            if ($this->user->test_ACL('privileges', 'issues_view_orgowned')) {
                $read_settings['ignore_dep_filter'] = true;
                $read_settings['ignore_user_filter'] = true;
            }

            if ($this->user->test_ACL('privileges', 'issue_access_deps'))
                $read_settings['ignore_dep_filter'] = true;

            // If the user is in stealth mode ( user status "invisble" ), he should not be added to the accessing list
            if ($user['status'] == 'invisible')
                $read_settings['no_access_update'] = true;

            // Read the issues with user-related filters in place (department, user himself, read will fail if organization is not connected to the record)
            $rec = $this->record->read($rq->track, $record_wtr, $perspective, $user['cdep_id'], $user['id'], $read_settings);
        }

        // When record not found or attempted to read it from a perspective of an organization not connected, stop.
        if (empty($rec))
            return $this->deny_Access($rq->track); // Not actually returning, because deny_Access will auto-redirect and end();

        $rec['organization']['is_master'] = !empty($rec['master_org_id']) ? $rec['master_org_id'] == $perspective : false;

        // Start checking extra restricitons ( normal users )
        if ($user['status'] != 'admin' && $user['status'] != 'supervisor') {

            // Check organization - User's organization must be either the master or one of the shared ones
            if (!($user['org_id'] == $rec['master_org_id'] || empty($rec['shared_org_ids']) || (!empty($rec['shared_org_ids']) && in_array($user['org_id'], $rec['shared_org_ids']))))
                return $this->deny_Access($rq->track);

            // New Privilege - Allow user to always see submitted records, even if they were moved, changed, different department. However, they still have to be connected to the user's organization ( previous check )
            if ($this->user->test_ACL('privileges', 'always_access_submissions') && $rec['submitter']['id'] == $user['contact']['id']) {

                $this->user->update_Local_ACL('privileges', array('issue_overview', 'issue_xfields', 'issue_view_comm'));

                // Privilege to see all records that belong to the organization, ignoring record types access, groups access or assignments - Used by certain super-users - Will skip further checks
            } elseif (!$this->user->test_ACL('privileges', 'issues_view_orgowned')) {

                // Check access to Record Type
                if (!$this->user->test_ACL('ist', $rec['type_id']))
                    return $this->deny_Access($rq->track);

                // Check access to Groups
                if (!in_array($rec['group_id'], array_keys($this->user->read_ACL('groups'))))
                    return $this->deny_Access($rq->track);

                // Finally check assignments (without certain privileges, access to a record is given only if that record has been assigned to an user)
                $unassgn = $this->user->test_ACL('privileges', 'issues_view_unassgn');
                $otherassgn = $this->user->test_ACL('privileges', 'issues_view_assgn_oth');

                $assgn_based_allowed = false;
                if ($unassgn == true && $otherassgn == true) {
                    // see all from the connected groups
                    $assgn_based_allowed = true;
                } elseif ($unassgn == true && $otherassgn == false) {
                    // assigned to self and unassigned
                    if ($rec['assigned_to'] == $user['id'] || empty($rec['assigned_to']))
                        $assgn_based_allowed = true;
                } elseif ($unassgn == false && $otherassgn == true) {
                    // assigned to self and to others
                    if ($rec['assigned_to'] == $user['id'] || !empty($rec['assigned_to']))
                        $assgn_based_allowed = true;
                } elseif ($unassgn == false && $otherassgn == false) {
                    // only assigned to self
                    if ($rec['assigned_to'] == $user['id'])
                        $assgn_based_allowed = true;
                }

                if (!$assgn_based_allowed) {
                    // Assignment based-check failed - Deny access
                    return $this->deny_Access($rq->track);
                }
            }

            // When user is assigned to record, certain privileges are temporarely activated
            // -- (has full access to everything this module offers except for external activity and deletion, those need to be granted specifically)
            // -- This is valid no matter if user has any visibility privileges
            // -- (valid only while on the record page - ajax calls, moving away will clear any of these)
            if ($rec['assigned_to'] == $user['id']) {
                $this->user->update_Local_ACL('privileges', array(
                    // Ability to edit records and send communication
                    'issue_xfields', 'issue_edit_xfields', 'record_send_data', 'issue_sendby_mail', 'issue_view_comm', 'issue_manage_comm',
                    // Files, Tasks, Notes/Docs, Contacts, Sharing, History
                    'issue_view_attachs', 'issue_edit_attachs', 'tasks_access', 'tasks_manager', 'issue_view_notes', 'issue_edit_notes', 'issue_view_contacts', 'issue_edit_contacts', 'issue_view_sharing', 'issue_view_history',
                    // Change of Group, Status, Priority, Close record
                    'issue_set_group', 'issue_set_status', 'issue_set_priority', 'issue_close'
                ));
            }

            // Read success - User mode - If this is the first time this record is opened, the "open_time" is saved and "process" marker is set to "opened"
            // TODO: Do it with a delay (via JS+AJAX), so the overview actually stays on the screen for at least 30 seconds in order to be considered as viewed.
            if ($rec['process'] == 'pending')
                $this->record->org_MarkProcess($rec['id'], 'opened');
        }

        // A little visual fix - If priority begins with a number followed by a dot, cut the first two characters
        // (The numbers are necessary for ordering in the grid groups, as it's not possible to custom order grouping, and instead goes alphabetically)
        if (is_numeric($rec['priority'][0]))
            $rec['priority'] = substr($rec['priority'], 2);

        return $rec;
    }

