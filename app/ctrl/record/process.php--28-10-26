              if(isset($convo['org'])) {
              $row['org'] = $convo['org'];
              $row['org']['id'] = empty($convo['org_id'])? null: (int)$convo['org_id'];
              if(!empty($convo['org']['contact_id']))
              $row['org']['contact_id'] = (int)$convo['org']['contact_id'];
              }

              // Is there still a starter message, put the information about this message in the data
              if($convo['start_msg_id'] > 0) {
              $row['starter']['id'] = (int)$convo['start_msg_id'];
              if(!is_null($convo['start_msg']['to_id']) && !empty($convo['contacts'][1])) {
              $row['recipient']['id'] = (int)$convo['start_msg']['to_id'];
              $row['recipient']['email'] = $convo['contacts'][1]['email'];
              $row['recipient']['name'] = $convo['contacts'][1]['name'];
              }
              $row['starter']['time'] = date("Y-m-d H:i:s", $convo['start_msg_time']);
              $row['starter']['subject'] = $convo['start_msg']['subject'];
              // 				$row['starter']['content'] = $convo['start_msg']['content'];
              }

              if(!empty($convo['last_msg_sender'])) {
              $row['last_msg'] = array();
              $row['last_msg']['from_id'] = (int)$convo['last_msg_sender'];
              $row['last_msg']['time'] = date("Y-m-d H:i:s", $convo['last_msg_time']);
              }

              // Package the list of contacts into one JSON, it will be used when opening the row detail to show the involved contacts in the conversation
              $contacts_pack = array();
              foreach($convo['contacts'] as $idx=> &$contact) {
              $contacts_pack[] = array(
              'id'=> (int)$contact['id'],
              'type'=> $contact['type'],
              'email'=> $contact['email'],
              'name'=> $contact['name']
              );

              // Also discover the last_msg_sender here if there is one
              // 				if(!empty($convo['last_msg_sender']) && $convo['last_msg_sender'] == $contact['id']) {
              // 					$convo['last_msg']['email'] = $contact['email'];
              // 					$convo['last_msg']['name'] = $contact['name'];
              // 				}
              }
              // There is a bit of redundancy due to the fact that at least two of the contact informations are present both in the "starter"/"last_msg" fields and in the contacts_package.
              // This is needed to display the rows quickly, but also show ALL the contacts in the row details
              $row['contacts_pack'] = json_encode($contacts_pack);
             */
            $all[] = $convo;
        }

        $contacts = $this->con->get_List(null, array_unique($contacts_all, SORT_NUMERIC), 'idlist', array('org', 'allstates'), null, 0); // No sorting here. Contacts will be sorted during distribution
        // Index the $contacts array by ID
        $contacts_idx = array();
        foreach ($contacts as $idx => &$con) {
            $contacts_idx[$con['id']] = $idx;
        }
        unset($con);

        // Begin distribution of contacts and cleanup
        foreach ($all as &$convo) {
            $convo['count_ctx'] = count($convo['contact_ids']);

            $convo_contacts = array();
            foreach ($convo['contact_ids'] as $con_id)
                if (isset($contacts[$contacts_idx[$con_id]])) // It's possible that some of the contacts don't exist anymore; Make that visible
                    $convo_contacts[] = $contacts[$contacts_idx[$con_id]];
                else
                    $convo_contacts[] = array(
                        'id' => 0,
                        'org_id' => 0,
                        'name' => "(Deleted contact: ID {$con_id})"
                    );
            if (isset($convo_contacts[0]['email']))
                $convo['starter']['from_email'] = $convo_contacts[0]['email'];
            $convo['starter']['from_name'] = $convo_contacts[0]['name'];

            $convo['contacts_pack'] = json_encode($convo_contacts);

            // Cleanup
            unset($convo['linked_id'], $convo['contact_ids']);
        }

        return $this->send_JSON($all);
    }

    /**
     * Assembles and sends a specific conversation (containing all messages) as a HTML ajax result
     * @param MVC_Request $rq
     */
    public function action_Load_Conversation(MVC_Request $rq) {
        if (!$rq->id)
            return header("HTTP/1.0 400 Conversation ID not present in the request");

        // Read the conversation (all messages, contacts)
        $this->cnv = $this->factory_Model("Conversation", "cnv");
        $this->comm = $this->factory_Model('Comm');

        $convo = $this->cnv->read($rq->id, array("conversation", "messages", "contacts", "attachments")); // "attachments" require "messages" to also be present to have any effect
        // Special processing related to Bcc: contacts
        // - These are not normally loaded into the conversation, however when message is sent by the logged in user or the logged in user is an admin, Bcc: list should be visible
        // - In that case, read those contacts and append them to the message
        foreach ($convo['messages'] as &$message) {
            if (!empty($message['recipients']['bcc']) && ($this->user->is_Unrestricted() || $message['from_id'] == MVC_Core::$ss->user['contact_id']))
                $message['recipients']['bcc'] = $this->con->get_List(null, $message['recipients']['bcc'], "idlist");
            else
                unset($message['recipients']['bcc']);
        }

        // Make a smart guess on who to reply in the conversation
        // -- If last last_message_sender exists and is different from the current logged in user's contact id, that one is used as reply target
        // -- If last_message_sender is equal to the logged in user's contact id, reply_to will be the last contact in the list of contact_ids, which is not the user's contact id
        // -- ... unless there are no choices, in which case the reply_to ID will be the user's own contact id (talking to himself for some weird purpose?)
        if (!empty($convo['last_msg_sender'])) {
            if ($convo['last_msg_sender'] != MVC_Core::$ss->user['contact_id'])
                $reply_to = (int) $convo['last_msg_sender'];
            else {
                // Search the contact ids list in reverse, first result that is not the user's own contact id is chosen
                $rev_contact_ids = array_reverse($convo['contact_ids']);
                foreach ($rev_contact_ids as $c_id)
                    if ($c_id != MVC_Core::$ss->user['contact_id']) {
                        $reply_to = $c_id;
                        break;
                    }
            }
        }
        // Nothing found, nobody else to reply to, pick the first contact in the list
        if (!isset($reply_to))
            $reply_to = $convo['contact_ids'][0];

        // Hybrid response data
        $data_response = array();
        $data_response['tab_conversation'] = array(
            'type' => $convo['type'],
            'reply_to' => (int) $reply_to // Used to determine who to reply by default in this conversation
        );

        // Hybrid response (HTML+JSON)
        $this->send_JSON_Headers($data_response);

        $this->init_Template_System();
        echo $this->_drytpl->render_File("includes" . DS . "conversation.html", $convo);
    }

    /**
     * Updates some data for an existing conversation (visibility, description)
     *
     * FIXME: This shouldn't be here... actually, the entire "conversation" control module should be in /global, so conversations can be edited/operated from other modules
     */
    public function action_Convo_Config(MVC_Request $post) {
        if (empty(MVC_Core::$ss->user))
            return header("HTTP/1.0 403 This method is only available while logged in");

        if (empty($post->id))
            return header("HTTP/1.0 400 Conversation identifier was found in the request");

        // A bit of pre-processing of the file data
        // - trim and cut name+extension to less than 160 chars, same goes for description )
        // - break the labels and trim each one of them, also checking for duplicates (if same label is used more than once, it is ignored)
        $convo_update = $post->convo;

        if (empty($convo_update['description']) || strlen($convo_update['description']) < 4 || strlen($convo_update['description']) >= 200)
            return header("HTTP/1.0 400 The conversation subject is empty, too short or too long");
        $convo_update['description'] = trim($convo_update['description']);

        // Read the conversation, check the difference and verify visibility (TODO: and access)
        $m_convo = new App_Model_Conversation();
        $convo = $m_convo->read($post->id, array("conversation"));
        if (empty($convo))
            return header("HTTP/1.0 404 Conversation record not found, it may have been deleted.");

        // Compare new meta with current file meta
        foreach ($convo_update as $key => $value) {
            if ($value == $convo[$key])
                unset($convo_update[$key]);
        }

        if (empty($convo_update))
            return header("HTTP/1.0 409 No values were changed. There's nothing to update !");

        if (!empty($convo_update['visibility'])) {
            // When visibility is changed, some extra conditions need to be verified
            switch ($convo_update['visibility']) {
                case 'private':
                    // Conversation private only to recipient contacts.
                    if (!in_array((string) MVC_Core::$ss->user['contact_id'], explode(',', $convo['contact_ids'])))
                        return header("HTTP/1.0 403 This conversation can only be made private by the involved people.");

                case 'shared':
                    if (empty($convo_update['access_orgs']))
                        $convo_update['access_orgs'] = MVC_Core::$ss->user['org_id']; // At minimum, the user's own org should be in the list of access_orgs
                case 'org':
                    // If the file didn't have an owner organization before, just set the owner to current user's org. This is a bit insecure, it allows "stealing" public files, but it will have to do for now
                    if (empty($convo['org_id']))
                        $convo_update['org_id'] = (int) MVC_Core::$ss->user['org_id'];
            }
        }

        $r = $m_convo->update($post->id, $convo_update, false, $post->link_id);
        if (!$r)
            return header("HTTP/1.0 500 Error - Could not update the conversation");

        $this->send_JSON(array("success" => true, "response" => "The conversation has been updated."));
    }

