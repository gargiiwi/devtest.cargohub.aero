    public function action_save_linked_supplier(MVC_Request $post) {
        $param['link_id'] = $post->link_id;
        $data = array(
            'asset_track' => $post->track,
            'asset_issue_id' => $post->link_id,
            'asset_issue_type_id' => $post->type_id,
            'org_id' => $post->org_id,
            'contract_id' => $post->contract_id,
            'supplier_issue_id' => $post->supplier_id,
            'status' => 'active',
        );
        $saveData = $this->record->saveLinkedSupplier($param, $data);

        if ($saveData) {
            $update_asset_xfield = $this->record->update_asset_xfield($post->contract_id, $post->supplier_id);
 
            if ($update_asset_xfield && count($update_asset_xfield) > 0) {
                $row = $update_asset_xfield;

                $this->record->updateXfield(array(
                    'issue_id' => $post->link_id,
                    'fk_id' => '3881',
                    'value' => $row['supplier_name']
                ));
 
                $this->record->updateXfield(array(
                    'issue_id' => $post->link_id,
                    'fk_id' => '3883',
                    'value' => $row['contract_nr']
                ));
 
                $this->record->updateXfield(array(
                    'issue_id' => $post->link_id,
                    'fk_id' => '3901',
                    'int_value' => strtotime($row['start_date'])
                ));
 
                $this->record->updateXfield(array(
                    'issue_id' => $post->link_id,
                    'fk_id' => '3902',
                    'int_value' => strtotime($row['end_date'])
                ));
            }
            $this->send_JSON(array(
                'success' => true,
                'message' => 'Contract saved successfully '
            ));
        } else {
            $this->send_JSON(array(
                'success' => false,
                'message' => 'Opps! Unable to save contract '
            ));
        }
    }

