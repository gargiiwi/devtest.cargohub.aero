    /**
     * Links files uploaded via the the File Uploader to the current record
     */
    public function action_Link_Pre_Files() {
        list($rq, $rec, $org_id) = $this->check_Operation("issue_view_attachs", "Your account cannot upload new files", "post", array());

        $file_ids = @json_decode($rq->file_ids, true);
        if (!$file_ids)
            return header("HTTP/1.0 400 No files were uploaded !");

        $this->factory_Model('File');
        $this->file->update_Extra($file_ids, array(
            'linked_with' => "issue",
            'linked_id' => $rec['id'],
            'visibility' => $rq->visibility, // Visibility is choosen in the interface
            'org_id' => $org_id,
            'dep_id' => $this->user->is_Unrestricted() ? null : MVC_Core::$ss->user['cdep_id'],
            'access_orgs' => !empty($rq->access_orgs) ? $rq->access_orgs : null
        ));

        // (Re)Count total number of files linked to this record (issue)
        $count = $this->file->count("issue", $rec['id'], 'linked', $org_id);

        $this->record->org_UpdateData($rec['id'], $org_id, array(
            'count_files' => $count['files'], // For now, recount them every time; In the future after a global counters fix is deployed, just increment ( "`count_notes` + 1" )
            'filesize_total' => (int) $count['bytes']
                ), true, false); // Don't recheck locator ; String expressions

        $this->record->history_Create($rec['id'], array(
            'uploaded' => count($file_ids)
                ), 'file');

        // Update the file counter and total storage space for the org_id that owns these new files
        $q = QueryFactory::update()
                ->table(MVC_Core::$db->tab['org'])
                ->values(array(
                    'count_files' => "`count_files`+ " . count($file_ids),
                    'files_total_kbytes' => "`files_total_kbytes`+ " . (int) round($rq->upload_size / 1024)
                        ), null, true)
                ->where("`id` = ?", $org_id);
        MVC_Core::$db->query($q);

        $this->send_JSON(array("response" => sprintf("%d files have been connected to the record %s", count($file_ids), $rq->track), "count" => (int) $count['files']));
    }

    /**
     * Adds a reference in the File Clipboard to the selected file
     * @param MVC_Request $rq
     */
    public function action_File_CopyClip(MVC_Request $rq) {
        if (empty($rq->chash))
            return header("HTTP/1.0 400 File CHash identifier was not present in the request");

        // Find and read the file metadata. Required to check security and also determine for which organization the file counter is reduced.
        $this->factory_Model('File');
        $file_meta = $this->file->find(function (QueryFactory $q) use ($rq) {
            $q->where("`linked_with` = 'issue'")
                    ->where("`linked_id` = ?", $rq->link_id)
                    ->where("`chash` = ?", $rq->chash);
        });

        if (!$file_meta)
            return header("HTTP/1.0 404 The file was not found or is not accessible");

        $r = $this->file->clipboard_Attach($this->user->ID(), $file_meta['id']);
        if (!$r)
            return header("HTTP/1.0 500 Error encountered. The file might already be in the clipboard");

        // Attach successful - Scan clipboard to determine it's current size and return that
        $this->send_JSON(array('success' => true, 'fclipsize' => $this->file->clipboard_Check($this->user->ID())));
    }

    /**
     * Creates a duplicate of a referenced file ID to the current record
     *
     * @param MVC_Request $rq
     */
    public function action_File_Paste() {
        list($rq, $rec, $org_id) = $this->check_Operation('issue_edit_attachs', "You are not allowed to delete attachments.", 'post', array());

        if (empty($rq->chash))
            return header("HTTP/1.0 400 File CHash identifier was not present in the request");
        if (empty($rq->link_id))
            return header("HTTP/1.0 400 Record ID not present in the request; Possible interface error.");

        // Find and read the file metadata. Required to check security and also determine for which organization the file counter is reduced.
        $this->factory_Model('File');
        $file_meta = $this->file->find(function (QueryFactory $q) use ($rq) {
            // This time it's only located by CHASH, as $link_id represent the current record, not the original from where this file was copied
            $q->where("`chash` = ?", $rq->chash);
        });

        if (!$file_meta)
            return header("HTTP/1.0 404 The file was not found. Might have already been deleted. Please refresh!");

        $copies = $this->file->copy_Ref($file_meta['id'], array(
            'linked_with' => $rq->link_type ?: "issue",
            'linked_id' => $rq->link_id,
            'visibility' => "org",
            'user_id' => $this->user->ID(),
            'org_id' => $org_id,
            'count_reads' => 0
        ));
        if (empty($copies))
