                $this->send_JSON(array('success' => true, 'active_capa_count' => $active_capa));
                break;
                
//                IWI If record close then all active capa should be close end
                
            default:
                // Other markings are not possible through the interface
                header("HTTP/1.0 403 Operation {$post->command} is not allowed");
        }
    }

    /**
     * Primary check if user is logged in and the record TrackID is present in the request.
     * -- Almost all operations need these two values
     *
     * @param MVC_Request $rq
     * @param bool $admin_function If true, only superusers have access to the function
     */
    protected function check_TrackID(MVC_Request &$rq, $admin_function = false) {
        // Check user Session
        if (empty(MVC_Core::$ss->user)) {
            $msg = "This method is only available while logged in";
            if (App_Router::$ajax) {
                header("HTTP/1.0 403 " . $msg);
                MVC_Core::shutdown();
            } else {
                $this->evan->add($msg, 'lock');
                $this->redirect("/");
            }
        }

        if ($admin_function && !$this->user->is_Unrestricted())
            return header("HTTP/1.0 403 No access to this function");

        // Check record Identifier (TrackID)
        if (!empty($rq->_urlx) && $rq->_urlx[0] == ':')
            $rq->track = substr($rq->_urlx, 1);
        $rq->add_Filter('track', "Is_TrackID");
        if (!$rq->track) {
            $msg = "Record ID missing from the request";
            if (App_Router::$ajax) {
                header("HTTP/1.0 400 " . $msg);
                MVC_Core::shutdown();
            } else {
                $this->evan->add($msg, "warning");
                $this->redirect("/issue/list");
            }
        }
    }

    /**
     * Checks if the operation is allowed for the logged in user and rejects it (by redirecting or returning FAIL Json)
     *
     * @param string|bool $privilege_to_check If "true", no privilege is needed (yet all the data is read)
     * @param string $privilege_error_message
     * @param string $request
     * @return array(MVC_Request, array)
     */
    protected function check_Operation($privilege_to_check, $privilege_error_message, $request = 'get', $wtr = array('issue')) {
        // Check user Session
        if (empty(MVC_Core::$ss->user)) {
            $msg = "This method is only available while logged in";
            if (App_Router::$ajax) {
                header("HTTP/1.0 403 " . $msg);
                MVC_Core::shutdown();
            } else {
                $this->evan->add($msg, 'lock');
                $this->redirect("/");
            }
        }

        $rq = new MVC_Request($request);

        // Check Identifier (Track)
        if (!empty($_GET['_urlx']) && $_GET['_urlx'][0] == ':')
            $rq->track = substr($_GET['_urlx'], 1);
        $rq->add_Filter('track', "Is_TrackID");

        // read the issue to see if it exists (and other data)
        if ($rq->track)
            $rec = $this->record->read($rq->track, $wtr);
        elseif ($rq->rec_id)
            $rec = $this->record->read($rq->rec_id, $wtr);
        else {
            $msg = "Record ID missing from the request";
            if (App_Router::$ajax) {
                header("HTTP/1.0 400 " . $msg);
                MVC_Core::shutdown();
            } else {
                $this->evan->add($msg, "warning");
                $this->redirect("/issue/list");
            }
        }

        if (empty($rec)) {
            $msg = "Record not found (Possible old link?)";
            if (App_Router::$ajax) {
                header("HTTP/1.0 404 " . $msg);
                MVC_Core::shutdown();
            } else {
                $this->evan->add($msg, "warning");
                $this->redirect("/issue/list");
            }
        }

        if (!($privilege_to_check === true || $this->user->test_ACL('privileges', $privilege_to_check) || (isset($rec['assigned_to']) && $rec['assigned_to'] == $this->user->ID()) )) {
            $msg = sprintf($privilege_error_message, $rec['track']);
            if (App_Router::$ajax) {
                header("HTTP/1.0 403 " . $msg);
                MVC_Core::shutdown();
            } else {
                $this->evan->add(sprintf($privilege_error_message, $rec['track']), 'lock');
                $this->redirect("/record/process:{$rq->track}");
            }
        }

        $org_id = $this->user->is_Unrestricted() ? (isset(MVC_Core::$ss->perspective) ? MVC_Core::$ss->perspective : $rec['master_org_id']) : MVC_Core::$ss->user['org_id'];
        return array($rq, $rec, $org_id);
    }

    /**
     * Sets the Status or Priority of a record
     * @param MVC_Request $post
     * @return boolean
     */
    public function action_Set_Stat_Prio(MVC_Request $post) {
        switch ($post->fn) {
            case 'priority':
                $wtr = array('issue', 'typeex');
                $type_index = "priorities";
                $rec_field = "priority_key";
                break;
            case 'status':
                $wtr = array('issue', 'typeex', 'shared_orgs'); // Under certain conditions all statuses should be updated (not just for the current organization)
                $type_index = "statuses";
                $rec_field = "status_key";
                break;
            default:
                return header("HTTP/1.0 405 Unsupported function: {$post->fn}");
        }
        $function = $post->fn;

        list($post, $rec, $org_id) = $this->check_Operation('issue_set_' . $function, "You are not allowed to change the {$function} of record %s.", 'post', $wtr);

        // Verify if specified status or priority appears in the list of available ones for current record type (secondary server check)
        // TODO: This will change once per-organization-(type) statuses and priorities are available (from the whole bunch)
        if (!in_array($post->key, $rec['type'][$type_index]))
            return header("HTTP/1.0 409 The requested {$function} change is invalid for this record type.");

        $return = array(
            'fn' => $function,
            'key' => $post->key,
        );

        // Load and check automation settings
        $automation = MVC_Core::$spyc->loadFile(ROOT . DS . 'app' . DS . 'data' . DS . 'automation.yaml');

        switch ($function) {
            case 'priority':
                break;
            case 'status':
                if (isset($automation['issue']['status'])) {
                    // is the mentioned status in "autoclose" ?
                    if (in_array($post->key, $automation['issue']['status']['autoclose']))
                        $return['autoclose'] = true;
                    if (in_array($post->key, $automation['issue']['status']['autoopen']))
                        $return['autoopen'] = true;
                }

                // TODO: Status Sync function (copy/change from item.php if still needed)
                break;
        }

        // Only change process when it was on a default/automated mode:
        if (in_array($rec['process'], array("pending", "webapi", "opened")))
            $fields_update = $this->record->org_MarkProcess($rec['id'], 'active', $org_id, true, $rec['linktime']); // This happens for admin as well, it's a change which will be visible by org members
        else
            $fields_update = array();
        $fields_update[$rec_field] = $post->key;

        // Set the meta function for selected organization
        $r = $this->record->org_UpdateData($rec['id'], $org_id, $fields_update, true);
        if (!$r)
            return header("HTTP/1.0 500 An error occured while attempting to update the record");

        // On successful update, clear export markers for the record (for all users)
        $this->record->marker_UpdateAll($rec['id'], array('export_ut' => false));
        // ... and add a history record
        $this->record->history_Create($rec['id'], array(
