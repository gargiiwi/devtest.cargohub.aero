    function generateModifiedPath($variable) {
        // Step 1: Extract the parts of the path by splitting the string by "/"
        $path_parts = explode('/', $variable);
        
        if (count($path_parts) >= 3) {
            // Step 2: Combine the first two parts ("1" and "a") to form "1a"
            $first_part = $path_parts[0] . $path_parts[1];  // "1a"
            
            // Step 3: Get the remaining part of the path (i.e., the file name)
            $file_name = $path_parts[2];
            
            // Step 4: Construct the new path
            $modified_path = $first_part . '/' . $file_name;
            
            // Return the modified path
            return $modified_path;
        }
        
        return '';  // Return an empty string if the format is unexpected
    }


