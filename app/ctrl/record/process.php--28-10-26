    /**
     * Reads the data groups which should be available for current record
     */
    public function action_Get_Groups(MVC_Request $rq) {
        $this->check_TrackID($rq);

        // Read the record type for the active
        $rt_def = $this->record->ist_Read($rq->rt_id, null);

        if (!isset($rt_def['settings']['group_type']))
            return header("HTTP/1.0 405 This record type doesn't support groups.");

        $group_id_list = $this->user->is_Unrestricted() ? array() : array_keys($this->user->read_ACL('groups'));

        // Extra filter - Check if issue type has restrictions on which group IDs are visible for it ( this are absolute and do not depend on any rights or who accesses the issue type, including admin )
        // - It allows group type sharing between multiple issue types
        if (!empty($rt_def['group_ids']))
            $group_id_list = array_intersect($group_id_list, $rt_def['group_ids']);
        if (empty($group_id_list) && isset($rt_def['group_ids']))
            $group_id_list = $rt_def['group_ids'];

        $this->factory_Model('Group', null, $rt_def['settings']['group_type']);

        // Read the available groups, based on the list
        $r = $this->group->get_List(array(), function (QueryFactory &$q) use ($group_id_list) {
            if (!empty($group_id_list))
                $q->where('`grp`.id IN(?)', $group_id_list);
        }, null, "`name` ASC");

        if (!$r || count($r) == 0)
            return header("HTTP/1.0 404 No groups were found !");

        $groups = array();
        foreach ($r as $row) {
            // Filter for group name tags
            $row['name'] = trim(preg_replace('/\[.*?\]/', "", $row['name']));
            $groups[] = $row;
        }
        $this->send_JSON($groups);
    }

    /**
     * Sets the group for current record
     */
    public function action_Set_Group() {
        list($post, $rec, $org_id) = $this->check_Operation('issue_set_group', "You are not allowed to set the record group for %s.", 'post', array('issue', 'typeex'));

        if (!$post->id)
            return header("HTTP/1.0 400 Group ID missing from the request");

        if ($post->id == $rec['group_id'])
            return header("HTTP/1.0 409 The record is already in the selected group");

        // check if the group_id is in the allowed groups for this user
        if (!$this->user->is_Unrestricted() && !$this->user->test_ACL('groups', $post->id))
            return header("HTTP/1.0 409 You are not allowed to set this group");

        $r = $this->record->update($rec['id'], array(
            'group_id' => $post->id
        ));
        if (!$r)
            return header("HTTP/1.0 500 Failed to set the group for this record");

        // Success! Read the new group name to return it to JS
        $m_group = new App_Model_Group($rec['type']['settings']['group_type']);
        $group = $m_group->read($post->id);

        $this->send_JSON(array(
            'success' => true,
            'group_name' => $group['name'],
            'response' => sprintf("The record has been moved to: %s", $group['name'])
        ));
    }

