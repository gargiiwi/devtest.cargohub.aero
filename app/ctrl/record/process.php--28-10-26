    /**
     * Appends an record TrackID to a list of "recently loaded", along with the type and Cache-Primary (if it exists). This is a per-user record, stored in the profiles table
     * - Used to create a "recently loaded" list of items, for quicker navigation between records.
     *
     * @param string $rec_track
     * @param int $rt_id
     * @param string $primary
     * @param array The function returns the recent records list, including filters and what was updated
     */
    private function rec_Save_To_Recent($rec_track, $rt_id, $primary = null) {
        // Load the user profile containing the issue open history
        $recent = $this->user->profile_Read($this->user->ID(), "iss_recent", false, 1, true);
        if (empty($recent))
            $recent = array();

        // go through the profile data and find the track. If found in another position than first, it is removed and reinserted in the beginning (most recently loaded is always first)
        $pos = 0;
        $found = false;
        foreach ($recent as $track => $data) {
            if ($track == $rec_track) {
                // Found it !
                if ($pos == 0) {
                    $data['time'] = time();
                    $recent[$track] = $data;
                } else {
                    // not first position, extract from array and reinsert
                    unset($recent[$track]);
                    $recent = array($track => $data) + $recent;
                }
                $found = true;
                break;
            }
            // When is in the recent list of a record type to which the user doesn't have access anymore, remove it
            if (!isset(MVC_Core::$cache->record_types_index[$data['ist']])) {
                unset($recent[$track]);
                continue;
            }

            $pos++;
        }
        if (!$found)
            $recent = array($rec_track => array('ist' => $rt_id, 'pri' => $primary, 'time' => time())) + $recent;

        // Limit to max 18 "recent" issues (that's what it fits in the Dashboard panel) ; In case the method of showing recents is changed, also change this limit
        if (count($recent) > 18)
            $recent = array_splice($recent, 0, 18);

        // Save it back to the user profile record
        $first = reset($recent);
        $this->user->profile_Write($this->user->ID(), "iss_recent", $recent, false, sprintf("Recently opened issues (Most recent time: %s)", date("Y-m-d H:i:s", $first['time'])));

        // Add the RT information to the array, for display purposes
        if (!empty($recent))
            foreach ($recent as $track => $data) {
                $rt_info = &MVC_Core::$cache->record_types[MVC_Core::$cache->record_types_index[$data['ist']]];
                $recent[$track]['rt_key'] = $rt_info['key'];
                $recent[$track]['rt_name'] = $rt_info['name'];
            }

        return $recent;
    }

    /**
     * Scans for potential duplicate records (that have the same value for the specified index field)
     * Returns a list of tracking numbers and the submitter Name/Organization/E-mail
     *
     * @param array $qi_field_list List of quickindex fields to scan for
     * @param int $current_rec_id If present, avoid returning self
     * @return int Count of potential duplicates, based on all quickindex fields
     */
    private function rec_Scan_Quickindex(&$qi_field_list, $org_id = null, $rec_id = null) {
        $total_count = 0;
        foreach ($qi_field_list as &$qie) {

            if (is_null($qie['value']) || strlen($qie['value']) == 0)
                continue; // Skips search when there's no value/empty string

            $qie['list'] = $this->record->search_By_Quickindex($qie['id'], $qie['value'], array('issue', 'submitter'), $org_id, $rec_id);
            $qie['count'] = count($qie['list']);
            $total_count += $qie['count'];
        }

        return $total_count;
    }

