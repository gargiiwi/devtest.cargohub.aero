    /**
     * Local file delete method. Perhaps make universal one in the future?
     */
    public function action_Delete_File() {
        list($rq, $rec, $org_id) = $this->check_Operation('issue_edit_attachs', "You are not allowed to delete attachments.", 'post', array());

        if (empty($rq->chash))
            return header("HTTP/1.0 400 File CHash identifier was not present in the request");

        // Find and read the file metadata. Required to check security and also determine for which organization the file counter is reduced.
        $this->factory_Model('File');
        $file_meta = $this->file->find(function (QueryFactory $q) use ($rq) {
            $q->where("`linked_with` = 'issue'")
                    ->where("`linked_id` = ?", $rq->link_id)
                    ->where("`chash` = ?", $rq->chash);
        });

        if (!$file_meta)
            return header("HTTP/1.0 404 The file was not found. Might have already been deleted. Please refresh!");

        // Delete the file record
        $r = $this->file->delete($file_meta['id'], $file_meta['linked_with']);
        if (!$r)
            return header("HTTP/1.0 500 File deletion failed, possible database error");

        // Also remove file from Clipboard (from all users), as it will not be possible to "paste" if it stays there
        $this->file->clipboard_Detach(-1, $file_meta['id']);

        $result = array('success' => true, 'response' => "The file has been deleted.");
        // Depending on what is being linked, update counters or statistics field
        $count = $this->file->count("issue", $rq->link_id, 'linked', $file_meta['org_id']);

        $this->record->org_UpdateData($rq->link_id, $file_meta['org_id'], array(
            'count_files' => $count['files'],
            'filesize_total' => (int) $count['bytes']
                ), true); // Don't recheck locator

        $this->record->history_Create($rec['id'], array(
            'deleted' => 1,
            'name' => $file_meta['name'],
            'size' => $file_meta['size']
                ), 'file');

        if ($file_meta['org_id'] == $org_id) {
            $result['update_count'] = true;
            $result['count'] = (int) $count['files'];
        }

        // Update the clipboard count for current user
        $result['fclipsize'] = $this->file->clipboard_Check($this->user->ID());

        $this->send_JSON($result);
    }

