    /**
     * Computes the list of organizations which can receive access to an issue, based on several rules:
     * - 1. The list of partnerships for the sender organization is being loaded
     *   (If the value "filter_partners" exists in the organization features, only read types of partners available for the issue type; If not, read all partnership records)
     * - 2. If the value "auto_partners" exists in the organization features, read ALL organizations of the specified types and add them to the list of possible partners.
     * - 3. Using the organization data, check the following things and remove organizations that do not match:
     *     3A. The organization must have access to the issue type ( Table: i2o ), and to the group ( Table: g2o ), having the field enabled = 1
     *     3B. Within the same table, the value "receive" must be 1, or the partner organiaztion should not be shown ( it can't accept this issue type )
     *     (actually, the initial filter is done before steps 1 and 2)
     *     3C. Finally, the organization must not already be connected to the issue and enabled (issue_orgdata -> is_enabled = 1 )
     * Input parameters:
     * - Selected Organization ID ( defaults to logged in user organization )
     * - Current Issue Group (For determining group connections)
     * - Current Issue ID (Needed for a quick list of connected organizations - Step 3C)
     *
     * @param MVC_Request $rq
     */
    public function action_Get_Partners(MVC_Request $rq) {
        $org_id = $this->user->is_Unrestricted() ? (isset(MVC_Core::$ss->perspective) ? MVC_Core::$ss->perspective : $rq->org_id) : MVC_Core::$ss->user['org_id'];

        if (!empty($org_id)) {
            // Read the organization of the user (or the selected organization)
            $view_org = $this->org->read($org_id, array('organization'));
            if (empty($view_org))
                return header("HTTP/1.0 404 Organization {$org_id} not found");
        }

        // 3. Well, this is step 3 in the plan, but it's better to have it here, since it can create a powerful filter so much less partners are read.
        // It will only return the list of organization ID's which have access to the group and the issue type
        $q = QueryFactory::select()
                ->table(MVC_Core::$db->table('i2o'), 'org_id')
                ->where("`i2o`.istkey = ?", $rq->rt_key)
                ->where("`i2o`.enabled = 1 AND `i2o`.receive = 1")
                // Join the g2o table and limit the specified group
                ->table(MVC_Core::$db->table('g2o'), false, 'left', "(`org_id`)")
                ->where("`g2o`.group_id = ?", $rq->group_id)
                ->where("`g2o`.f_receive = 1"); // Organization is allowed to receive data from this group
        // Obviously, the current organization should not be part of this list

        if (!empty($org_id))
            $q->where("`i2o`.org_id != ?", $org_id);

        $r = MVC_Core::$db->query($q);
        if (!$r || count($r) == 0)
            return array(); // There are no partners available, return empty list.

        $org_access_list = array();
        foreach ($r as $item)
            $org_access_list[] = (int) $item['org_id'];

        if (!empty($org_id)) {
            // 1. Read the "direct" (explicit) partners, from the "par" table.
            $direct_partners_filter = null;
            if (!empty($view_org['features']['direct_partners'][$rq->rt_key])) {
                $org_type_list = $view_org['features']['direct_partners'][$rq->rt_key];
                if (is_string($org_type_list))
                    $org_type_list = explode(',', $org_type_list);
                // Filtering the types of partners for the specified issue type
                $direct_partners_filter = $org_type_list;
            }

            $partners = $this->org->partnership_Get_List($org_id, true, $direct_partners_filter, $org_access_list);
        }

        if (empty($partners))
            $partners = array();

        // Make a list of org ID's from the partners array, so it can be searched quickly when adding auto-partners
        $par_ids = array();
        foreach ($partners as $par)
            $par_ids[] = (int) $par['id'];

        if (empty($org_id)) {
            // When the record is not linked to any organization, list all which may have access to the record ( via the $org_access_list )
            $orgs = $this->org->get_List(array(), function (QueryFactory &$q) use ($org_access_list) {
                $q->where('`org`.id IN (?)', $org_access_list);
            }, null, "`org`.name ASC", 0); // Read all orgs, no limit.
        } elseif (!empty($view_org['features']['auto_partners'][$rq->rt_key])) {
            // When origin organization is known add the Auto Partners ( All organizations of a certain type available for a particular issue type )
            $org_type_list = $view_org['features']['auto_partners'][$rq->rt_key];
            if (is_string($org_type_list))
                $org_type_list = explode(',', $org_type_list);

            // Read all the organizations of the specified types in "auto_partners", for discovering the possible data sharing targets
            $orgs = $this->org->get_List(array(), function (QueryFactory &$q) use ($org_type_list, $org_access_list) {
                $q->where('`org`.type_id IN (?)', $org_type_list)
                        ->where('`org`.id IN (?)', $org_access_list);
            }, null, "`org`.name ASC", 0); // Read all orgs, no limit.
        }

        // Add automatic lists to the list of possible partners
        if (isset($orgs))
            foreach ($orgs as $org) {
                if (!in_array($org['id'], $par_ids))
                    $partners[] = $org;
            }

        if (empty($partners)) {
            MVC_Core::$debug->dump("No organizations could be located under current conditions", __METHOD__, null, "warning");
            return $this->send_JSON(array());
        }

        // 3C - Will be delayed, not really that important.
        $this->send_JSON($partners);
    }

