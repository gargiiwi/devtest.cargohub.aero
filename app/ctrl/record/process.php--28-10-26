    /**
     * Links one or more existing contacts (from the user's address book) to the opened record
     */
    public function action_Link_Contacts() {
        list($rq, $rec, $org_id) = $this->check_Operation('issue_edit_contacts', "You are not allowed to link contacts.", 'post', array());

        if (!$rq->ids)
            return header("HTTP/1.0 400 No contact IDs are present in the request");

        $contact_ids = explode(',', $rq->ids);
        $total_linked = 0;
        foreach ($contact_ids as $con_id) {
            $r = $this->con->con2iss_Create($rec['id'], $con_id, array(
                'role' => 'custom',
                'label' => $rq->label ?: "Manually linked",
                'visibility' => "org", // Contacts are initially visible only to the organization that linked them
                'org_id' => $org_id,
                'user_id' => $this->user->ID()
            ));
            if (!$r)
                continue;

            // When type is specified and is "draft", change the type to "isslink" for the linked contacts
            if ($rq->type == 'draft') {
                $this->con->update($con_id, array(
                    'type' => "isslink"
                ));
            }

            $total_linked++;
        }

        $con_count = count($contact_ids);

        if ($total_linked == 0)
            return header("HTTP/1.0 500 No contacts have been linked. It may be that they are already linked");

        $this->record->org_UpdateData($rec['id'], $org_id, array(
            'count_contacts' => "`count_contacts` + {$total_linked}"
                ), true, true); // Don't recheck locator ; String expressions

        if ($con_count == $total_linked)
            return $this->send_JSON(array('response' => "A total of {$total_linked} contact(s) have been linked to this record!"));
        else
            return $this->send_JSON(array('response' => "{$total_linked} out of {$con_count} contact(s) have been linked"));
    }

    /**
     * Unlinks a contact from a record
     * (only one, as the datatable is configured to only select one contact)
     */
    public function action_Unlink_Contact() {
        list($rq, $rec, $org_id) = $this->check_Operation('issue_edit_contacts', "You are not allowed to unlink contacts.", 'post', array());
        if (!$rq->id)
            return header("HTTP/1.0 400 Contact ID not present in the request");

        // Read the contact link to see what's with it (only links of types "recipient" and "custom" can be unlinked).
        // "Submitter" is created on issue submit (and is mandatory) and "Assignee" is managed by the system, and will always be the contact of user which is currently assigned to the issue
        $contact = $this->con->con2iss_Read($rec['id'], $rq->id, $this->user->is_Unrestricted() ? null : $org_id);
        if (!$contact)
            return header("HTTP/1.0 403 You may not have the access rights to detach this contact");

        if ($contact['role'] == "submitter")
            return header("HTTP/1.0 403 The submitter contact cannot be detached, it is an important part of the record data");
        if ($contact['role'] == "assignee")
            return header("HTTP/1.0 409 Linking and detaching of assigned user's contact is automated by the assign/unassign functions");

        // Unlink accepted
        $r = $this->con->con2iss_Delete($rec['id'], $rq->id, $this->user->is_Unrestricted() ? null : $org_id);
        if (!$r)
            return header("HTTP/1.0 500 Error - Unable to detach this contact");

        $this->record->org_UpdateData($rec['id'], $org_id, array(
            'count_contacts' => "`count_contacts` - 1"
                ), true, true); // Don't recheck locator ; String expressions

        $this->send_JSON(array('response' => "The contact has been detached. Address book contacts still exist and may be reattached."));
    }

