    function getValueByKey($inputString, $key) {
        // Define the regular expression pattern to match the key and its value
        $pattern = "/#$key:\s*([^,]+)/";
    
        // Use preg_match to find the value associated with the key
        if (preg_match($pattern, $inputString, $matches)) {
            // Return the value found
            return $matches[1];
        } else {
            // If the key is not found, return null
            return null;
        }
    }

