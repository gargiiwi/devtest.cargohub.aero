    /**
     * Saves the current state of the docking panels - This is called with every panel moving, opening, closing, collapse/expand operation,
     *   so the system knows exactly in which state the panels are at every moment. This is used to recover the state after coming back to the page
     */
    public function action_Save_Docking_State(MVC_Request $post) {
        // analyse the export, and remove panels which are in a "closed" state (so they are not recreated at next init)
        $panels = $post->panels;
        $panel_layout = json_decode($post->panel_export, true);
//		if(empty($panel_layout))
// 			return header("HTTP/1.0 400 Invalid panel layout, possibly problems in JS");

        $open_panels = array();
        foreach ($panel_layout['panel0'] as $key => $window) {
            if ($panels[$key] == 'closed')
                unset($panel_layout['panel0'][$key]);
            else
                $open_panels[] = $key;
        }
        foreach ($panel_layout['panel1'] as $key => $window) {
            if ($panels[$key] == 'closed')
                unset($panel_layout['panel1'][$key]);
            else
                $open_panels[] = $key;
        }
        // Panels cannot be floated anymore, this has no use
        foreach ($panel_layout['floating'] as $key => $window) {
            if ($panels[$key] == 'closed')
                unset($panel_layout['floating'][$key]);
            else
                $open_panels[] = $key;
        }

        $rt_id = $post->rt_id;

        $this->user->profile_Write($this->user->ID(), "overview_ist_{$rt_id}", array(
            'panel_layout' => $panel_layout,
            'open_windows' => $open_panels // Currently unused
        ));
        $this->send_JSON(array('success' => true));
    }

