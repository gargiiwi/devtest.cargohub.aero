    /**
     * Admin function: Changes the current "Master" organization for an issue and shares it back with the previous owner and other organizations that were originally sharing it
     * Of course, the organization still needs to have access to the issue group, or they won't be able to access the issue.
     * -- This method works even if the organization is already connected
     * @param MVC_Request $rq
     */
    public function action_Set_Master_Org(MVC_Request $rq) {
        $this->check_TrackID($rq, true);

        // Attempt to add the selected organization to the list of orgs which are sharing this issue
        $org = $this->record->org_Add($rq->track, $rq->org_id, null, null, false, false, false, 'self'); // False = Do not update issue at this stage, it will be updated anyway on the "set master"
        if (!$org)
            return header("HTTP/1.0 500 Error while connecting organization to the issue.");

        // If connect succeeded (or it was already connected), now set the organization as master
        $r = $this->record->org_SetAsOwner($rq->track, $rq->org_id);
        if (!$r)
            return header("HTTP/1.0 500 Error while attempting to set the organization as master.");

        if (!is_array($org))
            $org = $this->org->read($rq->org_id, array());

        $response = "Ownership of this record given to <b>{$org['name']}</b>";
        if ($rq->reload_mode) {
            $this->evan->add($response, "ok");
            $this->send_JSON(array('success' => true));
        } else
            $this->send_JSON(array('success' => true, 'response' => $response));
    }

